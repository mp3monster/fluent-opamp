{
  "description": "Version targets consumed by `opamp-cli dev-version-bump`. Each component has its own currentVersionSource so default bumps advance that component from its own current version. Targets are limited to release-owned project/package metadata; generated Git metadata, dependency versions, schema/API versions, and test fixture values are documented as exclusions.",
  "components": [
    {
      "id": "agent-broker",
      "label": "Agent broker",
      "currentVersionSource": {
        "path": "agent_broker/pyproject.toml",
        "pattern": "^version = \"([^\"]+)\"$"
      },
      "targets": [
        {
          "path": "agent_broker/pyproject.toml",
          "pattern": "^version = \"[^\"]+\"$",
          "replacement": "version = \"{version}\""
        }
      ]
    },
    {
      "id": "catalog-service-python",
      "label": "Catalog service Python package",
      "currentVersionSource": {
        "path": "catalog-service/pyproject.toml",
        "pattern": "^version = \"([^\"]+)\"$"
      },
      "targets": [
        {
          "path": "catalog-service/pyproject.toml",
          "pattern": "^version = \"[^\"]+\"$",
          "replacement": "version = \"{version}\""
        }
      ]
    },
    {
      "id": "catalog-service-ui-tests",
      "label": "Catalog service UI test package",
      "currentVersionSource": {
        "path": "catalog-service/package.json",
        "pattern": "  \"version\": \"([^\"]+)\","
      },
      "targets": [
        {
          "path": "catalog-service/package.json",
          "pattern": "  \"version\": \"[^\"]+\",",
          "replacement": "  \"version\": \"{version}\",",
          "count": 1
        },
        {
          "path": "catalog-service/package-lock.json",
          "pattern": "\"version\": \"[^\"]+\"",
          "replacement": "\"version\": \"{version}\"",
          "count": 2
        }
      ]
    },
    {
      "id": "opamp-cli-python",
