  "excludedReferences": [
    {
      "paths": [
        "agent_broker/opamp_broker/version.json",
        "consumer-sim/version.json",
        "consumer-sim/src/opamp_consumer_sim/version.json",
        "consumer/src/opamp_consumer/version.json",
        "provider/src/opamp_provider/version.json"
      ],
      "reason": "Generated component metadata includes Git labels and commit details; it is refreshed by build/version tooling instead of direct release bumps."
    },
    {
      "paths": [
        "tests/**",
        "*/tests/**",
        "docs/**"
      ],
      "reason": "Fixture, example, and documentation versions must remain representative of the scenario being tested or described."
    },
    {
      "paths": [
        "**/node_modules/**",
        "**/uv.lock",
        "config-service/sbom/**"
      ],
      "reason": "Dependency, lock, and SBOM versions describe third-party packages or generated inventories."
    },
    {
      "paths": [
        "config-service/src/config_service/json-schemas/**",
        "provider/src/opamp_provider/mcptool/tool_openapi_spec.json",
        "cloud/azure/mainTemplate.json"
      ],
      "reason": "Schema, protocol, API, and infrastructure image versions are not OpAMP component release identifiers."
    }
