{
  "profiles": [
    {
      "name": "Test option (FLBx1, Fdx1)",
      "scenario_description": "Matches the existing Windows demo scripts: tests opamp/fluent-bit + consumer fluentd config.",
      "simulator": {
        "instances_path": "consumer-sim/config/consumer_instances.json"
      },
      "fluentbit": {
        "config_path": "tests/opamp.json",
        "agent_config_path": "tests/fluent-bit.yaml"
      },
      "fluentd": {
        "config_path": "consumer/opamp-fluentd.json",
        "agent_config_path": "consumer/fluentd.conf"
      }
    },
    {
      "name": "Demo setup (Simx1, Flbx1, Fdx1)",
      "scenario_description": "Uses the repository default Fluent Bit config and the dedicated Fluentd demo config.",
      "simulator": {
        "instances_path": "consumer-sim/config/consumer_instances.json"
      },
      "fluentbit": {
        "config_path": "config/opamp.json",
        "agent_config_path": "consumer/fluent-bit.yaml"
      },
      "fluentd": {
        "config_path": "consumer/opamp-fluentd.json",
        "agent_config_path": "consumer/fluentd.conf"
      }
    },
    {
      "name": "Demo setup (Flbx1-Watts2)",
      "scenario_description": "Uses the repository default Fluent Bit config and the dedicated Fluent Bit demo config.",
      "simulator": {
        "instances_path": "consumer-sim/config/consumer_instance-1.json"
      }
    },
    {
      "name": "Test setup (Flbx1 Observer)",
      "scenario_description": "Starts up the agent in the observer configuration. As a result this means that the Fluent Bit needs to be manually started first with a command e.g. fluent-bit -c consumer/fluent-bit.yaml .",
      "fluentbit": {
        "config_path": "tests/opamp-consumer-observer.json",
        "agent_config_path": "consumer/fluent-bit.yaml"
      }
    },
        {
          "name": "Test setup (Flbx1 Supervisor + Remote Config)",
          "scenario_description": "Supervisor setup that allows remote config",
          "fluentbit": {
            "config_path": "tests/opamp-consumer-with-remote.json",
            "agent_config_path": "consumer/fluent-bit-replacable.yaml"
          }
        },
        {
          "name": "Demo setup (Elastic Heartbeat supervisor to Logstash)",
          "scenario_description": "Runs Elastic Heartbeat as a supervisor-managed consumer, monitors localhost and blog.mp3monster.org every 5 seconds, and sends events to a local Logstash container that writes a test evidence file.",
          "elastic_heartbeat": {
            "config_path": "tests/logstash/opamp-consumer-elastic-heartbeat-logstash-plugin.json",
            "agent_config_path": "tests/logstash/heartbeat.yml"
          },
          "containers": [
            {
              "id": "logstash-heartbeat-local",
              "label": "Logstash local heartbeat pipeline",
              "container_name": "opamp-logstash-heartbeat",
              "replace_existing": true,
              "image_candidates": [
                "docker.elastic.co/logstash/logstash:9.5.1",
                "logstash:9.5.1"
              ],
              "ports": [
                "127.0.0.1:5044:5044"
              ],
              "volumes": [
                {
                  "host_path": "tests/logstash/logstash-heartbeat.container.conf",
                  "container_path": "/usr/share/logstash/pipeline/logstash.conf",
                  "read_only": true
                },
                {
                  "host_path": "tests/logstash/out",
                  "container_path": "/usr/share/logstash/out"
                }
              ],
              "ensure_dirs": [
                "tests/logstash/out"
              ],
              "command": [
                "logstash",
                "-f",
                "/usr/share/logstash/pipeline/logstash.conf"
              ],
              "aliases": [
                "logstash-heartbeat",
                "heartbeat logstash"
              ]
            }
          ]
        }
  ]
}
