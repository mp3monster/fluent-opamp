# Required
DEPLOYMENT_TYPE=fluentbit
AGENT_VERSION=5.0.3
WHEEL_PATH=/host-assets/dist/consumer/opamp_consumer-0.4.0-py3-none-any.whl

# Optional paths
AGENT_CONFIG_PATH=
CONSUMER_CONFIG_PATH=/host-assets/tests/opamp.json

# Connectivity
CONSUMER_TRANSPORT=http
OPAMP_HTTP_URL=http://host.docker.internal:8080
OPAMP_WEBSOCKET_URL=ws://host.docker.internal:4320
SERVER_URL=

# Runtime behavior
AGENT_ONLY=false
HOSTNAME_OVERRIDE=
SERVICE_NAME_OVERRIDE=
SERVICE_NAMESPACE_OVERRIDE=
OUTPUT_HOST_DIR=/host-output

# Optional explicit Fluent Bit asset URL override
FLUENTBIT_DOWNLOAD_URL=

# Optional ELK component downloads
DOWNLOAD_ELK_COMPONENTS=false
ELK_VERSION=
ELK_COMPONENTS=elasticsearch,kibana,logstash
EXTRACT_ELK_COMPONENTS=false
ELASTICSEARCH_DOWNLOAD_URL=
KIBANA_DOWNLOAD_URL=
LOGSTASH_DOWNLOAD_URL=
ELASTIC_AGENT_DOWNLOAD_URL=
FLEET_SERVER_DOWNLOAD_URL=

# Optional log generator download from GitHub
DOWNLOAD_LOG_GENERATOR=false
LOG_GENERATOR_GITHUB_REPO=https://github.com/mingrammer/flog.git
LOG_GENERATOR_GIT_REF=
LOG_GENERATOR_RELEASE_URL=
