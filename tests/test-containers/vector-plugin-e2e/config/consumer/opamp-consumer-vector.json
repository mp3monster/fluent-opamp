{
  "consumer": {
    "server_url": "http://provider:8080",
    "client_status_port": 8686,
    "chat_ops_port": 8888,
    "transport": "http",
    "tls": {
      "verify_server": false
    },
    "server-authorization": "none",
    "log_agent_api_responses": true,
    "agent_config_path": "/config/vector-self-monitor.yaml",
    "agent_additional_params": [],
    "heartbeat_frequency": 3,
    "service_type": "vector",
    "full_update_controller": {
      "fullResendAfter": 1
    },
    "full_update_controller_type": "SentCount",
    "allow_custom_capabilities": true,
    "log_level": "debug",
    "service_name": "Vector E2E",
    "service_namespace": "VectorPluginE2E",
    "vector": {
      "executable_path": "vector",
      "api_host": "127.0.0.1",
      "api_port": 8686,
      "status_timeout_seconds": 5
    },
    "plugins": [
      {
        "service_type": "vector",
        "entry_point": "opamp_consumer.vector.client:main",
        "enabled": true
      }
    ]
  }
}
