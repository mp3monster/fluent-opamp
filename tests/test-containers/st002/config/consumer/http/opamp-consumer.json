{
  "consumer": {
    "server_url": "http://provider:8080",
    "client_status_port": 2020,
    "chat_ops_port": 8888,
    "transport": "http",
    "tls": {
      "verify_server": false
    },
    "server-authorization": "none",
    "log_agent_api_responses": true,
    "agent_config_path": "/config/simulator-agent.yaml",
    "agent_additional_params": [
      "{\"service_instance_uid\":\"st002-simulator-http\",\"client_version\":\"ST002 HTTP simulator\",\"config_version\":\"st002-http-cfg\"}"
    ],
    "heartbeat_frequency": 3,
    "service_type": "simulator",
    "simulator_responses_path": "/config/simulator-responses.json",
    "full_update_controller": {
      "fullResendAfter": 1
    },
    "full_update_controller_type": "SentCount",
    "allow_custom_capabilities": true,
    "log_level": "debug",
    "service_name": "ST002 Simulator HTTP",
    "service_namespace": "ST002"
  }
}
