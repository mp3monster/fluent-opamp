{
  "consumer": {
    "server_url": "http://localhost:8080",
    "client_status_port": 1,
    "chat_ops_port": 8888,
    "transport": "http",
    "tls": {
      "verify_server": false
    },
    "server-authorization": "none",
    "log_agent_api_responses": false,
    "agent_config_path": "./consumer/fluent-bit.yaml",
    "agent_additional_params": [
      "{\"service_instance_uid\":\"simulator-01\",\"client_version\":\"1.0.0\",\"config_version\":\"cfg-001\"}"
    ],
    "heartbeat_frequency": 30,
    "service_type": "simulator",
    "simulator_responses_path": "./consumer/simulator-responses.example.json",
    "full_update_controller": {
      "fullResendAfter": 1
    },
    "full_update_controller_type": "SentCount",
    "allow_custom_capabilities": true,
    "log_level": "debug",
    "service_name": "Simulator",
    "service_namespace": "SimulatorNS"
  }
}
