{
  "type": "object",
  "title": "Podman Metrics",
  "properties": {
    "name": {
      "type": "string",
      "const": "podman-metrics",
      "title": "Plugin"
    },
    "scrape_interval": {
      "type": "integer",
      "description": "Interval between each scrape of podman data (in seconds)",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 30
    },
    "scrape_on_start": {
      "type": "boolean",
      "description": "Should this plugin scrape podman data after it is started",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "path.config": {
      "type": "string",
      "description": "Custom path to podman containers configuration file",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/var/lib/containers/storage/overlay-containers/containers.json"
    },
    "path.sysfs": {
      "type": "string",
      "description": "Custom path to sysfs subsystem directory",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/sys/fs/cgroup"
    },
    "path.procfs": {
      "type": "string",
      "description": "Custom path to proc subsystem directory",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/proc"
    },
    "threaded": {
      "type": "boolean",
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "tag": {
      "type": "string",
      "description": "Tag assigned to records emitted by this input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
