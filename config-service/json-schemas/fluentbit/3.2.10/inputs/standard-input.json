{
  "type": "object",
  "title": "Standard Input",
  "properties": {
    "name": {
      "type": "string",
      "const": "standard-input",
      "title": "Plugin"
    },
    "buffer_size": {
      "type": "string",
      "description": "Set the buffer size to read data.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": true,
      "x-config-data-type": "size",
      "x-references-parser": false,
      "default": "16k"
    },
    "parser": {
      "type": "string",
      "description": "The name of the parser to invoke instead of the default JSON input parser",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": true
    },
    "threaded": {
      "type": "boolean",
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "tag": {
      "type": "string",
      "description": "Tag assigned to records emitted by this input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "buffer_size",
    "tag"
  ],
  "additionalProperties": false
}
