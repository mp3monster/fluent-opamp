      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "It is not applied unless explicitly set"
    },
    "systemd_exclude_pattern": {
      "type": "string",
      "description": "regex to determine which units are excluded in the metrics produced by the systemd collector",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/node-exporter-metrics#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
