{
  "type": "object",
  "title": "Tail",
  "properties": {
    "name": {
      "type": "string",
      "const": "tail",
      "title": "Plugin"
    },
    "buffer_chunk_size": {
      "type": "string",
      "description": "Set the initial buffer size to read files data.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": true,
      "x-config-data-type": "size",
      "x-references-parser": false,
      "default": "32k"
    },
    "buffer_max_size": {
      "type": "integer",
      "description": "Set the limit of the buffer size per monitored file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": true,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": "32k"
    },
    "path": {
      "type": "string",
      "description": "Pattern specifying a specific log file or multiple ones through the use of common wildcards.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "path_key": {
      "type": "boolean",
      "description": "If enabled, it appends the name of the monitored file as part of the record.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false
    },
    "exclude_path": {
      "type": "string",
      "description": "Set one or multiple shell patterns separated by commas to exclude files matching certain criteria, e.g: Exclude_Path .gz,.zip",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "offset_key": {
      "type": "boolean",
      "description": "If enabled, Fluent Bit appends the offset of the current monitored file as part of the record.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false
    },
    "read_from_head": {
      "type": "boolean",
      "description": "For new discovered files on start (without a database offset/position), read the content from the head of the file, not tail.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "refresh_interval": {
      "type": "integer",
      "description": "The interval of refreshing the list of watched files in seconds.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 60
    },
    "rotate_wait": {
      "type": "integer",
      "description": "Specify the number of extra time in seconds to monitor a file once is rotated in case some pending data is flushed.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 5
    },
    "ignore_older": {
      "type": "string",
      "description": "Ignores files older than ignore_older.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "skip_long_lines": {
      "type": "string",
      "description": "When a monitored file reaches its buffer capacity due to a very long line (Buffer_Max_Size), the default behavior is to stop monitoring that file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "skip_empty_lines": {
      "type": "string",
      "description": "Skips empty lines in the log file from any further processing or output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "db": {
      "type": "string",
      "description": "Specify the database file to keep track of monitored files and offsets.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "db.sync": {
      "type": "string",
      "description": "Set a default synchronization (I/O) method.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "normal"
    },
    "db.locking": {
      "type": "boolean",
      "description": "Specify that the database will be accessed only by Fluent Bit.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "db.journal_mode": {
      "type": "string",
      "description": "sets the journal mode for databases (WAL).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "WAL"
    },
    "db.compare_filename": {
      "type": "boolean",
      "description": "This option determines whether to check both the inode and the filename when retrieving stored file information from the database.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "mem_buf_limit": {
      "type": "string",
      "description": "Set a limit of memory that Tail plugin can use when appending data to the Engine.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "size",
      "x-references-parser": false
    },
    "exit_on_eof": {
      "type": "boolean",
      "description": "When reading a file will exit as soon as it reach the end of the file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "parser": {
      "type": "string",
      "description": "Specify the name of a parser to interpret the entry as a structured message.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": true
    },
    "key": {
      "type": "string",
      "description": "When a message is unstructured (no parser applied), it's appended as a string under the key name log.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "log"
    },
    "inotify_watcher": {
      "type": "boolean",
      "description": "Set to false to use file stat watcher instead of inotify.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": true
    },
    "tag": {
      "type": "string",
      "description": "Set a tag (with regex-extract fields) that will be placed on lines read.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tag_regex": {
      "type": "string",
      "description": "Set a regex to extract fields from the file name.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "static_batch_size": {
      "type": "string",
      "description": "Set the maximum number of bytes to process per iteration for the monitored static files (files that already exists upon Fluent Bit start).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "size",
      "x-references-parser": false,
      "default": "50M"
    },
    "file_cache_advise": {
      "type": "string",
      "description": "Set the posix_fadvise in POSIX_FADV_DONTNEED mode.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "On"
    },
    "threaded": {
      "type": "boolean",
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/tail#configuration-parameters-a-hrefconfig-idconfiga",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "buffer_chunk_size",
    "buffer_max_size",
    "tag"
  ],
  "additionalProperties": false
}
