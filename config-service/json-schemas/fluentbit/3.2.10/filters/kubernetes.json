{
  "type": "object",
  "title": "Kubernetes",
  "properties": {
    "name": {
      "type": "string",
      "const": "kubernetes",
      "title": "Plugin"
    },
    "buffer_size": {
      "type": "string",
      "description": "Set the buffer size for HTTP client when reading responses from Kubernetes API server.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "size",
      "x-references-parser": false,
      "default": "32k"
    },
    "kube_url": {
      "type": "string",
      "description": "API Server end-point",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "<https://kubernetes.default.svc:443>"
    },
    "kube_ca_file": {
      "type": "string",
      "description": "CA certificate file",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    },
    "kube_ca_path": {
      "type": "string",
      "description": "Absolute path to scan for certificate files",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "kube_token_file": {
      "type": "string",
      "description": "Token file",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/token"
    },
    "kube_tag_prefix": {
      "type": "string",
      "description": "When the source records comes from Tail input plugin, this option allows to specify what's the prefix used in Tail configuration.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "kube.var.log.containers."
    },
    "merge_log": {
      "type": "boolean",
      "description": "When enabled, it checks if the log field content is a JSON string map, if so, it append the map fields as part of the log structure.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "merge_log_key": {
      "type": "boolean",
      "description": "When Merge_Log is enabled, the filter tries to assume the log field from the incoming message is a JSON string message and make a structured representation of it at the same level of the log field in the map.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false
    },
    "merge_log_trim": {
      "type": "boolean",
      "description": "When Merge_Log is enabled, trim (remove possible \\n or \\r) field values.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "On"
    },
    "merge_parser": {
      "type": "string",
      "description": "Optional parser name to specify how to parse the data contained in the log key.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": true
    },
    "keep_log": {
      "type": "boolean",
      "description": "When Keep_Log is disabled, the log field is removed from the incoming message once it has been successfully merged (Merge_Log must be enabled as well).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "On"
    },
    "tls.debug": {
      "type": "integer",
      "description": "Debug level between 0 (nothing) and 4 (every detail).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": -1
    },
    "tls.verify": {
      "type": "boolean",
      "description": "When enabled, turns on certificate validation when connecting to the Kubernetes API server.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "On"
    },
    "tls.verify_hostname": {
      "type": "boolean",
      "description": "When enabled, turns on hostname validation for certificates",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "use_journal": {
      "type": "boolean",
      "description": "When enabled, the filter reads logs coming in Journald format.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "cache_use_docker_id": {
      "type": "boolean",
      "description": "When enabled, metadata will be fetched from K8s when docker_id is changed.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "regex_parser": {
      "type": "string",
      "description": "Set an alternative Parser to process record Tag and extract pod_name, namespace_name, container_name and docker_id.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": true
    },
    "k8s-logging.parser": {
      "type": "string",
      "description": "Allow Kubernetes Pods to suggest a pre-defined Parser (read more about it in Kubernetes Annotations section)",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": true,
      "default": "Off"
    },
    "k8s-logging.exclude": {
      "type": "string",
      "description": "Allow Kubernetes Pods to exclude their logs from the log processor (read more about it in Kubernetes Annotations section).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "labels": {
      "type": "string",
      "description": "Include Kubernetes pod resource labels in the extra metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "On"
    },
    "annotations": {
      "type": "string",
      "description": "Include Kubernetes pod resource annotations in the extra metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "On"
    },
    "kube_meta_preload_cache_dir": {
      "type": "string",
      "description": "If set, Kubernetes meta-data can be cached/pre-loaded from files in JSON format in this directory, named as namespace-pod.meta",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "dummy_meta": {
      "type": "string",
      "description": "If set, use dummy-meta data (for test/dev purposes)",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "dns_retries": {
      "type": "integer",
      "description": "DNS lookup retries N times until the network start working",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 6
    },
    "dns_wait_time": {
      "type": "integer",
      "description": "DNS lookup interval between network status checks",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 30
    },
    "use_kubelet": {
      "type": "string",
      "description": "this is an optional feature flag to get metadata information from kubelet instead of calling Kube Server API to enhance the log.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "use_tag_for_meta": {
      "type": "boolean",
      "description": "When enabled, Kubernetes metadata (e.g., pod_name, container_name, namespace_name etc) will be extracted from the tag itself.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "kubelet_port": {
      "type": "integer",
      "description": "kubelet port using for HTTP request, this only works when Use_Kubelet set to On.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 10250
    },
    "kubelet_host": {
      "type": "string",
      "description": "kubelet host using for HTTP request, this only works when Use_Kubelet set to On.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "kube_meta_cache_ttl": {
      "type": "integer",
      "description": "configurable TTL for K8s cached pod metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "kube_token_ttl": {
      "type": "integer",
      "description": "configurable 'time to live' for the K8s token.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 600
    },
    "kube_token_command": {
      "type": "string",
      "description": "Command to get Kubernetes authorization token.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "kube_meta_namespace_cache_ttl": {
      "type": "integer",
      "description": "configurable TTL for K8s cached namespace metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 900
    },
    "namespace_labels": {
      "type": "string",
      "description": "Include Kubernetes namespace resource labels in the extra metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "namespace_annotations": {
      "type": "string",
      "description": "Include Kubernetes namespace resource annotations in the extra metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "namespace_metadata_only": {
      "type": "string",
      "description": "Include Kubernetes namespace metadata only and no pod metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "owner_references": {
      "type": "string",
      "description": "Include Kubernetes owner references in the extra metadata",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/kubernetes#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "buffer_size",
    "keep_log",
    "regex_parser"
  ],
  "additionalProperties": false
}
