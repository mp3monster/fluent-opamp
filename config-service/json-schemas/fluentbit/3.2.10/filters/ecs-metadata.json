{
  "type": "object",
  "title": "ECS Metadata",
  "properties": {
    "name": {
      "type": "string",
      "const": "ecs-metadata",
      "title": "Plugin"
    },
    "add": {
      "type": "string",
      "description": "This parameter is similar to the ADD option in the [modify filter](https://docs.fluentbit.io/manual/pipeline/filters/modify).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "No default"
    },
    "ecs_tag_prefix": {
      "type": "string",
      "description": "This parameter is similar to the Kube_Tag_Prefix option in the [Kubernetes filter](https://docs.fluentbit.io/manual/pipeline/filters/kubernetes) and performs the same function.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "emptry string"
    },
    "cluster_metadata_only": {
      "type": "boolean",
      "description": "When enabled, the plugin will only attempt to attach cluster metadata values.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "ecs_meta_cache_ttl": {
      "type": "string",
      "description": "The filter builds a hash table in memory mapping each unique container short ID to its metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "1h (1 hour)"
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
