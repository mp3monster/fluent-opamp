{
  "type": "object",
  "title": "Forward",
  "properties": {
    "name": {
      "type": "string",
      "const": "forward",
      "title": "Plugin"
    },
    "host": {
      "type": "string",
      "description": "Target host where Fluent-Bit or Fluentd are listening for Forward messages.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "description": "TCP Port of the target service.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 24224
    },
    "time_as_integer": {
      "type": "boolean",
      "description": "Set timestamps in integer format, it enable compatibility mode for Fluentd v0.12 series.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "upstream": {
      "type": "string",
      "description": "If Forward will connect to an Upstream instead of a simple host, this property defines the absolute path for the Upstream configuration file, for more details about this refer to the [Upstream Servers ](/manual/3.2/administration/configuring-fluent-bit/classic-mode/upstream-servers.md)documentation section.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "unix_path": {
      "type": "string",
      "description": "Specify the path to unix socket to send a Forward message.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tag": {
      "type": "string",
      "description": "Overwrite the tag as we transmit.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "send_options": {
      "type": "boolean",
      "description": "Always send options (with \"size\"=count of messages)",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "require_ack_response": {
      "type": "boolean",
      "description": "Send \"chunk\"-option and wait for \"ack\" response from server.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "compress": {
      "type": "boolean",
      "description": "Set to 'gzip' to enable gzip compression.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/3.2/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/forward#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 2
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
