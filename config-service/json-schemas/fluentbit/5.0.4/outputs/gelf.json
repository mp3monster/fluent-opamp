{
  "type": "object",
  "title": "Graylog Extended Log Format (GELF)",
  "properties": {
    "name": {
      "type": "string",
      "const": "gelf",
      "title": "Plugin"
    },
    "compress": {
      "type": "boolean",
      "description": "If transport protocol is udp, set this to compress UDP packets.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": true
    },
    "gelf_full_message_key": {
      "type": "string",
      "description": "Key to use as the long message that can, for example, contain a backtrace.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "gelf_host_key": {
      "type": "string",
      "description": "Key whose value is used as the name of the host, source, or application that sent this message.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "gelf_level_key": {
      "type": "string",
      "description": "Key to be used as the log level.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "gelf_short_message_key": {
      "type": "string",
      "description": "A short descriptive message.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "gelf_tag_key": {
      "type": "string",
      "description": "Key to be used for tag.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "gelf_timestamp_key": {
      "type": "string",
      "description": "Your log timestamp.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "host": {
      "type": "string",
      "description": "IP address or hostname of the target Graylog server.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "match": {
      "type": "string",
      "description": "Pattern to match which tags of logs to be sent by this plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "mode": {
      "type": "string",
      "description": "The protocol to use.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "udp"
    },
    "packet_size": {
      "type": "integer",
      "description": "If transport protocol is udp, you can set the size of packets to be sent.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 1420
    },
    "port": {
      "type": "integer",
      "description": "The port that your Graylog GELF input is listening on.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 12201
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/gelf#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "gelf_host_key",
    "gelf_level_key",
    "gelf_short_message_key"
  ],
  "additionalProperties": false
}
