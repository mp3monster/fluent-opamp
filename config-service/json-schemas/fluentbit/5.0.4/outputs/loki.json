{
  "type": "object",
  "title": "Loki",
  "properties": {
    "name": {
      "type": "string",
      "const": "loki",
      "title": "Plugin"
    },
    "host": {
      "type": "string",
      "description": "Loki base hostname or IP address.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "uri": {
      "type": "string",
      "description": "Specify a custom HTTP URI.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/loki/api/v1/push"
    },
    "port": {
      "type": "integer",
      "description": "The Loki TCP port.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 3100
    },
    "tls": {
      "type": "string",
      "description": "Use TLS authentication.",
