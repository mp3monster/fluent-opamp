      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "off"
    },
    "http_user": {
      "type": "string",
      "description": "Set HTTP basic authentication user name.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "http_passwd": {
      "type": "string",
      "description": "Set HTTP basic authentication password.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "bearer_token": {
      "type": "string",
      "description": "Set bearer token authentication token value.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "header": {
      "type": "string",
      "description": "Add additional arbitrary HTTP header key/value pair.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID used by default to push logs to Loki.",
