      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "line_format": {
      "type": "string",
      "description": "Format to use when flattening the record to a log line.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "json"
    },
    "auto_kubernetes_labels": {
      "type": "boolean",
      "description": "If set to true, adds all Kubernetes labels to the stream labels.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "tenant_id_key": {
      "type": "string",
      "description": "Specify the name of the key from the original record that contains the Tenant ID.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "buffer_size": {
      "type": "string",
      "description": "Maximum HTTP response buffer size.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "size",
      "x-references-parser": false,
      "default": "512KB"
    },
    "compress": {
      "type": "string",
      "description": "Set payload compression mechanism.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
