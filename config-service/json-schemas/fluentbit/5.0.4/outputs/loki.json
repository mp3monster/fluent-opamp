      "x-doc-required": false,
      "x-config-data-type": "list",
      "x-references-parser": false
    },
    "label_map_path": {
      "type": "string",
      "description": "Specify the label map path.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "structured_metadata": {
      "type": "array",
      "description": "(Optional.) Comma-separated list of key=value strings specifying structured metadata for the log line.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/loki#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "list",
      "x-references-parser": false
    },
    "structured_metadata_map_keys": {
      "type": "array",
