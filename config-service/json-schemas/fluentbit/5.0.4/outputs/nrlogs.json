{
  "type": "object",
  "title": "New Relic",
  "properties": {
    "name": {
      "type": "string",
      "const": "nrlogs",
      "title": "Plugin"
    },
    "api_key": {
      "type": "string",
      "description": "Your [New Relic API key](https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/new-relic#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "base_uri": {
      "type": "string",
      "description": "The New Relic API endpoint.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/new-relic#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "https://log-api.newrelic.com/log/v1"
    },
    "compress": {
      "type": "string",
      "description": "Sets the compression mechanism for the payload.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/new-relic#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "gzip"
    },
    "license_key": {
      "type": "string",
      "description": "Your [New Relic license key](https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/new-relic#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "workers": {
      "type": "integer",
      "description": "Sets the number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/new-relic#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "api_key",
    "license_key"
  ],
  "additionalProperties": false
}
