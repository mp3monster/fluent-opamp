      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/dynatrace#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "format": {
      "type": "string",
      "description": "The data format to be used in the HTTP request body.",
