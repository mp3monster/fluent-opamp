{
  "type": "object",
  "title": "Stackdriver",
  "properties": {
    "name": {
      "type": "string",
      "const": "stackdriver",
      "title": "Plugin"
    },
    "autoformat_stackdriver_trace": {
      "type": "boolean",
      "description": "Rewrite the trace field to include the projectID and format it for use with Cloud Trace.",
