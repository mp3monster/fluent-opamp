      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "service_account_email": {
      "type": "integer",
      "description": "The service account email address.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false
    },
    "service_account_secret": {
      "type": "integer",
      "description": "The service account private key.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false
    },
    "skip_invalid_rows": {
      "type": "string",
      "description": "Insert all valid rows of a request, even if invalid rows exist.",
