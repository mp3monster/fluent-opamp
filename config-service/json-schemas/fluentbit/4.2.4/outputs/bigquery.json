      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "dataset_id": {
      "type": "string",
      "description": "The dataset ID of the BigQuery dataset to write into.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "enable_identity_federation": {
      "type": "boolean",
      "description": "Enables workload identity federation as an alternative authentication method.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "Off"
    },
    "google_service_account": {
      "type": "integer",
      "description": "The email address of the Google service account to impersonate.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "integer",
      "x-references-parser": false
    },
    "google_service_credentials": {
      "type": "string",
      "description": "Absolute path to a Google Cloud credentials JSON file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Value of the environment variable `$GOOGLE_SERVICE_CREDENTIALS`."
    },
    "ignore_unknown_values": {
      "type": "string",
      "description": "Accept rows that contain values that don't match the schema.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Off"
