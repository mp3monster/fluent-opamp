      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "fluent"
    },
    "port": {
      "type": "integer",
      "description": "TCP port of the target InfluxDB service.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/influxdb#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 8086
    },
    "sequence_tag": {
      "type": "string",
      "description": "The name of the tag whose value is incremented for consecutive simultaneous events.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/influxdb#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tag_keys": {
      "type": "array",
      "description": "Space-separated list of keys to tag.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/influxdb#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "list",
      "x-references-parser": false
    },
    "uri": {
      "type": "string",
      "description": "Custom URI endpoint.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/influxdb#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/4.2/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/influxdb#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
