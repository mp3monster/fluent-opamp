{
  "type": "object",
  "title": "ECS metadata",
  "properties": {
    "name": {
      "type": "string",
      "const": "ecs",
      "title": "Plugin"
    },
    "add": {
      "type": "string",
      "description": "Similar to the add option in the [modify filter](/manual/4.2/data-pipeline/filters/modify.md).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "agent_endpoint_retries": {
      "type": "integer",
      "description": "Number of retries for failed metadata requests to the ECS Agent Introspection endpoint.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 2
    },
    "cluster_metadata_only": {
      "type": "boolean",
      "description": "When enabled, the plugin only attempts to attach cluster metadata values.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "ecs_meta_cache_ttl": {
      "type": "string",
      "description": "The filter builds a hash table in memory mapping each unique container short ID to its metadata.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "1h"
    },
    "ecs_meta_host": {
      "type": "string",
      "description": "The host name at which the ECS Agent Introspection endpoint is reachable.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "ecs_meta_port": {
      "type": "integer",
      "description": "The port at which the ECS Agent Introspection endpoint is reachable.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 51678
    },
    "ecs_tag_prefix": {
      "type": "string",
      "description": "Similar to the kube_tag_prefix option in the [Kubernetes filter](/manual/4.2/data-pipeline/filters/kubernetes.md) and performs the same function.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/ecs-metadata#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "\"\""
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "ecs_tag_prefix"
  ],
  "additionalProperties": false
}
