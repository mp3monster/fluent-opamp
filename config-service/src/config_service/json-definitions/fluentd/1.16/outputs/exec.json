{
  "title": "exec",
  "doc_url": "https://docs.fluentd.org/output/exec",
  "description": "Passes buffered event chunks to an external command.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "command",
      "required": true,
      "description": "External command invoked for each flushed chunk.",
      "reference": "https://docs.fluentd.org/output/exec",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "remove_prefix",
      "required": false,
      "description": "Prefix removed from the event tag before output.",
      "reference": "https://docs.fluentd.org/output/exec",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "remove_tag_prefix",
      "required": false,
      "description": "Legacy alias for remove_prefix.",
      "reference": "https://docs.fluentd.org/output/exec",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "allowed_children": [
    {
      "section": "buffer",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "format",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "inject",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "secondary",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this output.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
