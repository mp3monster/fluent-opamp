{
  "title": "forward",
  "doc_url": "https://docs.fluentd.org/output/forward",
  "description": "Forwards matched records to other Fluentd or Fluent Bit nodes.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "send_timeout",
      "required": false,
      "description": "Write timeout for outgoing connections.",
      "reference": "https://docs.fluentd.org/output/forward",
      "data_type": "time",
      "validation_rule": null,
      "default": "60s"
    },
    {
      "name": "recover_wait",
      "required": false,
      "description": "Delay before reconnecting to a recovered node.",
      "reference": "https://docs.fluentd.org/output/forward",
      "data_type": "time",
      "validation_rule": null,
      "default": "10s"
    },
    {
      "name": "heartbeat_type",
      "required": false,
      "description": "Heartbeat transport used for node health checks.",
      "reference": "https://docs.fluentd.org/output/forward",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "transport",
          "udp",
          "tcp",
          "none"
        ]
      },
      "default": "transport",
      "enum_options": [
        "transport",
        "udp",
        "tcp",
        "none"
      ]
    },
    {
      "name": "heartbeat_interval",
      "required": false,
      "description": "Interval between heartbeats.",
      "reference": "https://docs.fluentd.org/output/forward",
      "data_type": "time",
      "validation_rule": null,
      "default": "1s"
    },
    {
      "name": "require_ack_response",
      "required": false,
      "description": "Wait for acknowledgements from the downstream node.",
      "reference": "https://docs.fluentd.org/output/forward",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ],
  "allowed_children": [
    {
      "section": "buffer",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "secondary",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "service_discovery",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "transport",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this output.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
