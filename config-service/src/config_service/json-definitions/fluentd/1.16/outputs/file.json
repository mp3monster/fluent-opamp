{
  "title": "file",
  "doc_url": "https://docs.fluentd.org/output/file",
  "description": "Writes matched records to files on disk.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "path",
      "required": true,
      "description": "Output path or file prefix for generated files.",
      "reference": "https://docs.fluentd.org/output/file",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "append",
      "required": false,
      "description": "Append to existing output files.",
      "reference": "https://docs.fluentd.org/output/file",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "compress",
      "required": false,
      "description": "Compression algorithm for rotated chunks.",
      "reference": "https://docs.fluentd.org/output/file",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "text",
          "gzip",
          "zstd"
        ]
      },
      "default": "text",
      "enum_options": [
        "text",
        "gzip",
        "zstd"
      ]
    },
    {
      "name": "symlink_path",
      "required": false,
      "description": "Optional symlink pointing to the current output file.",
      "reference": "https://docs.fluentd.org/output/file",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    }
  ],
  "allowed_children": [
    {
      "section": "buffer",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "format",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "inject",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "secondary",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this output.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
