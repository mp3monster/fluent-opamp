{
  "title": "parser",
  "doc_url": "https://docs.fluentd.org/filter/parser",
  "description": "Parses one field from each record and merges parsed content back into the event.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "key_name",
      "required": true,
      "description": "Record field containing the raw content to parse.",
      "reference": "https://docs.fluentd.org/filter/parser",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "reserve_data",
      "required": false,
      "description": "Keep original record fields alongside parsed content.",
      "reference": "https://docs.fluentd.org/filter/parser",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "remove_key_name_field",
      "required": false,
      "description": "Remove the source key after a successful parse.",
      "reference": "https://docs.fluentd.org/filter/parser",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "emit_invalid_record_to_error",
      "required": false,
      "description": "Route invalid records to the @ERROR label.",
      "reference": "https://docs.fluentd.org/filter/parser",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": true
    }
  ],
  "allowed_children": [
    {
      "section": "parse",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this filter.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
