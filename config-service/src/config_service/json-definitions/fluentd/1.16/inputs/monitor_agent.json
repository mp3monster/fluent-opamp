{
  "title": "monitor_agent",
  "doc_url": "https://docs.fluentd.org/input/monitor_agent",
  "description": "Exposes Fluentd runtime metrics and plugin state over HTTP.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "@label",
      "required": false,
      "description": "Routes emitted events to a named label.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "bind",
      "required": false,
      "description": "Bind address for the monitor endpoint.",
      "reference": "https://docs.fluentd.org/input/monitor_agent",
      "data_type": "string",
      "validation_rule": null,
      "default": "0.0.0.0"
    },
    {
      "name": "port",
      "required": false,
      "description": "Port used by the monitor endpoint.",
      "reference": "https://docs.fluentd.org/input/monitor_agent",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      },
      "default": 24220
    },
    {
      "name": "tag",
      "required": false,
      "description": "Optional tag used when monitor data is emitted as an event.",
      "reference": "https://docs.fluentd.org/input/monitor_agent",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "include_config",
      "required": false,
      "description": "Include full plugin config in monitor responses.",
      "reference": "https://docs.fluentd.org/input/monitor_agent",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "include_retry",
      "required": false,
      "description": "Include retry state in monitor responses.",
      "reference": "https://docs.fluentd.org/input/monitor_agent",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ]
}
