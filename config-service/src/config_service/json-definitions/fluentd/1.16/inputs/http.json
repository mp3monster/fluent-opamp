{
  "title": "http",
  "doc_url": "https://docs.fluentd.org/input/http",
  "description": "Accepts event payloads over HTTP.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "@label",
      "required": false,
      "description": "Routes emitted events to a named label.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port used by the HTTP input.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      },
      "default": 9880
    },
    {
      "name": "bind",
      "required": false,
      "description": "Bind address for the HTTP listener.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "string",
      "validation_rule": null,
      "default": "0.0.0.0"
    },
    {
      "name": "body_size_limit",
      "required": false,
      "description": "Maximum accepted request body size.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "size",
      "validation_rule": null,
      "default": "32m"
    },
    {
      "name": "keepalive_timeout",
      "required": false,
      "description": "HTTP keepalive timeout.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "time",
      "validation_rule": null,
      "default": "10s"
    },
    {
      "name": "respond_with_empty_img",
      "required": false,
      "description": "Respond with a tracking pixel rather than an empty body.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "add_http_headers",
      "required": false,
      "description": "Store request headers in the record.",
      "reference": "https://docs.fluentd.org/input/http",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ],
  "allowed_children": [
    {
      "section": "parse",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "transport",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ]
}
