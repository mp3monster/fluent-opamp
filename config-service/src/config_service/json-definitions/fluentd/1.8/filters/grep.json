{
  "title": "grep",
  "doc_url": "https://docs.fluentd.org/filter/grep",
  "description": "Keeps or drops records by matching field values with regular expressions.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "called_enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    }
  ],
  "allowed_children": [
    {
      "section": "regexp",
      "cardinality": {
        "minimum": 0,
        "maximum": null
      }
    },
    {
      "section": "exclude",
      "cardinality": {
        "minimum": 0,
        "maximum": null
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this filter.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
