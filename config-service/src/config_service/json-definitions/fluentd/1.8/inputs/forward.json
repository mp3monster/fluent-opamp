{
  "title": "forward",
  "doc_url": "https://docs.fluentd.org/input/forward",
  "description": "Accepts Fluentd Forward protocol traffic from remote senders.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "@label",
      "required": false,
      "description": "Routes emitted events to a named label.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port used for forward input.",
      "reference": "https://docs.fluentd.org/input/forward",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      },
      "default": 24224
    },
    {
      "name": "bind",
      "required": false,
      "description": "Bind address for the forward listener.",
      "reference": "https://docs.fluentd.org/input/forward",
      "data_type": "string",
      "validation_rule": null,
      "default": "0.0.0.0"
    },
    {
      "name": "source_hostname_key",
      "required": false,
      "description": "Record key used to inject the remote sender hostname.",
      "reference": "https://docs.fluentd.org/input/forward",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "source_address_key",
      "required": false,
      "description": "Record key used to inject the remote sender IP address.",
      "reference": "https://docs.fluentd.org/input/forward",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "skip_invalid_event",
      "required": false,
      "description": "Drop invalid incoming forward events rather than raising an error.",
      "reference": "https://docs.fluentd.org/input/forward",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ],
  "allowed_children": [
    {
      "section": "transport",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ]
}
