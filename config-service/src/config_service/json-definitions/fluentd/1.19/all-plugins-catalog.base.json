{
  "catalog_type": "plugin-catalog",
  "schema_version": "1.0.0",
  "engine": "fluentd",
  "fluentd_version": "1.19",
  "description": "Curated Fluentd 1.19 plugin catalog for config-service, including nested section metadata.",
  "plugins": {
    "inputs": {},
    "filters": {},
