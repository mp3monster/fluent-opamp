  "nested_sections": {
    "parse": {
      "title": "parse",
      "description": "Nested parser section used by source, filter, and some output plugins.",
      "plugin_backed": true,
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      },
      "reference": "https://docs.fluentd.org/configuration/parse-section",
      "variants": {
        "json": {
          "title": "json",
          "doc_url": "https://docs.fluentd.org/parser/json",
          "description": "Parses each event as JSON.",
          "fields": [
            {
              "name": "time_key",
              "required": false,
              "description": "Record key containing event time.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": null
            },
            {
              "name": "time_type",
              "required": false,
              "description": "How to parse the time value.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "enum",
              "validation_rule": {
                "kind": "enum",
                "values": [
                  "float",
                  "unixtime",
                  "string"
                ]
              },
              "default": "float",
              "enum_options": [
                "float",
                "unixtime",
                "string"
              ]
            },
            {
              "name": "time_format",
              "required": false,
              "description": "Time format used when time_type is string.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": null
            },
            {
              "name": "keep_time_key",
              "required": false,
              "description": "Preserve the original time key in the record.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "boolean",
              "validation_rule": {
                "kind": "boolean"
              },
              "default": false
            }
          ]
        },
        "regexp": {
          "title": "regexp",
          "doc_url": "https://docs.fluentd.org/parser/regexp",
          "description": "Parses records using a regular expression with named captures.",
          "fields": [
            {
              "name": "expression",
              "required": true,
              "description": "Regular expression with named capture groups.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": {
                "kind": "regex_string"
              }
            },
            {
              "name": "time_key",
              "required": false,
              "description": "Capture group used as the event time.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": null
            },
            {
              "name": "time_format",
              "required": false,
              "description": "Time format used when parsing the captured time string.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": null
            }
          ]
        },
        "multiline": {
          "title": "multiline",
          "doc_url": "https://docs.fluentd.org/parser/multiline",
          "description": "Parses multiline records using firstline and format expressions.",
          "fields": [
            {
              "name": "format_firstline",
              "required": true,
              "description": "Pattern matching the first line of a multiline event.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": {
                "kind": "regex_string"
              }
            },
            {
              "name": "format1",
              "required": true,
              "description": "Primary regular expression for joined multiline content.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": {
                "kind": "regex_string"
              }
            },
            {
              "name": "format2",
              "required": false,
              "description": "Optional second format expression.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": {
                "kind": "regex_string"
              }
            }
          ]
        },
        "none": {
          "title": "none",
          "doc_url": "https://docs.fluentd.org/parser/none",
          "description": "Passes the full input line through without parsing.",
          "fields": [
            {
              "name": "message_key",
              "required": false,
              "description": "Key name that will hold the raw event payload.",
              "reference": "https://docs.fluentd.org/configuration/parse-section",
              "data_type": "string",
              "validation_rule": null,
              "default": "message"
            }
          ]
        }
      }
    },
    "buffer": {
      "title": "buffer",
      "description": "Nested output buffer section controlling chunking, flushing, and retry behavior.",
      "plugin_backed": true,
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      },
      "reference": "https://docs.fluentd.org/configuration/buffer-section",
      "variants": {
        "file": {
          "title": "file",
          "doc_url": "https://docs.fluentd.org/buffer/file",
          "description": "Persistent on-disk buffer plugin.",
          "fields": [
            {
              "name": "@id",
              "required": false,
              "description": "Unique identifier for the plugin instance.",
              "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
              "data_type": "string",
              "validation_rule": null
            },
            {
              "name": "@log_level",
              "required": false,
              "description": "Plugin-specific log level that overrides the global system log level.",
              "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
              "data_type": "enum",
              "validation_rule": {
                "kind": "enum",
                "values": [
                  "trace",
                  "debug",
                  "info",
                  "warn",
                  "error",
                  "fatal"
                ]
              },
              "default": "info",
              "enum_options": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal"
              ]
            },
            {
              "name": "path",
              "required": false,
              "description": "Directory or file prefix used for buffer chunks.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "string",
              "validation_rule": {
                "kind": "regex_string"
              }
            },
            {
              "name": "chunk_keys",
              "required": false,
              "description": "Chunk keys rendered into the <buffer ARG> directive argument.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "list",
              "validation_rule": {
                "kind": "list"
              }
            },
            {
              "name": "chunk_limit_size",
              "required": false,
              "description": "Maximum chunk size before flush.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "size",
              "validation_rule": null,
              "default": "8m"
            },
            {
              "name": "total_limit_size",
              "required": false,
              "description": "Maximum total size across staged and queued chunks.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "size",
              "validation_rule": null,
              "default": "512m"
            },
            {
              "name": "flush_interval",
              "required": false,
              "description": "Interval between flush operations.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "time",
              "validation_rule": null,
              "default": "60s"
            },
            {
              "name": "retry_timeout",
              "required": false,
              "description": "Overall retry timeout before the chunk is discarded or handed to secondary output.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "time",
              "validation_rule": null,
              "default": "72h"
            },
            {
              "name": "overflow_action",
              "required": false,
              "description": "Behavior when the buffer queue is full.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "enum",
              "validation_rule": {
                "kind": "enum",
                "values": [
                  "throw_exception",
                  "block",
                  "drop_oldest_chunk"
                ]
              },
              "default": "throw_exception",
              "enum_options": [
                "throw_exception",
                "block",
                "drop_oldest_chunk"
              ]
            }
          ]
        },
        "memory": {
          "title": "memory",
          "doc_url": "https://docs.fluentd.org/buffer/memory",
          "description": "In-memory buffer plugin.",
          "fields": [
            {
              "name": "@id",
              "required": false,
              "description": "Unique identifier for the plugin instance.",
              "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
              "data_type": "string",
              "validation_rule": null
            },
            {
              "name": "@log_level",
              "required": false,
              "description": "Plugin-specific log level that overrides the global system log level.",
              "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
              "data_type": "enum",
              "validation_rule": {
                "kind": "enum",
                "values": [
                  "trace",
                  "debug",
                  "info",
                  "warn",
                  "error",
                  "fatal"
                ]
              },
              "default": "info",
              "enum_options": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal"
              ]
            },
            {
              "name": "chunk_keys",
              "required": false,
              "description": "Chunk keys rendered into the <buffer ARG> directive argument.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "list",
              "validation_rule": {
                "kind": "list"
              }
            },
            {
              "name": "chunk_limit_size",
              "required": false,
              "description": "Maximum chunk size before flush.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "size",
              "validation_rule": null,
              "default": "8m"
            },
            {
              "name": "total_limit_size",
              "required": false,
              "description": "Maximum total in-memory buffer size.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "size",
              "validation_rule": null,
              "default": "512m"
            },
            {
              "name": "flush_interval",
              "required": false,
              "description": "Interval between flush operations.",
              "reference": "https://docs.fluentd.org/configuration/buffer-section",
              "data_type": "time",
              "validation_rule": null,
              "default": "60s"
            }
          ]
        }
      }
    },
