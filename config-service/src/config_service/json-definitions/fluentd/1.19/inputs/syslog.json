{
  "title": "syslog",
  "doc_url": "https://docs.fluentd.org/input/syslog",
  "description": "Receives syslog messages over UDP or TCP.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "@label",
      "required": false,
      "description": "Routes emitted events to a named label.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "port",
      "required": false,
      "description": "Port used for the syslog listener.",
      "reference": "https://docs.fluentd.org/input/syslog",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      },
      "default": 5140
    },
    {
      "name": "bind",
      "required": false,
      "description": "Bind address for the syslog listener.",
      "reference": "https://docs.fluentd.org/input/syslog",
      "data_type": "string",
      "validation_rule": null,
      "default": "0.0.0.0"
    },
    {
      "name": "tag",
      "required": true,
      "description": "Base tag assigned to emitted syslog events.",
      "reference": "https://docs.fluentd.org/input/syslog",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "message_format",
      "required": false,
      "description": "Expected syslog message format.",
      "reference": "https://docs.fluentd.org/input/syslog",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "rfc3164",
          "rfc5424",
          "auto"
        ]
      },
      "default": "rfc3164",
      "enum_options": [
        "rfc3164",
        "rfc5424",
        "auto"
      ]
    },
    {
      "name": "emit_unmatched_lines",
      "required": false,
      "description": "Emit unparsable lines instead of dropping them.",
      "reference": "https://docs.fluentd.org/input/syslog",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ],
  "allowed_children": [
    {
      "section": "parse",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "section": "transport",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ]
}
