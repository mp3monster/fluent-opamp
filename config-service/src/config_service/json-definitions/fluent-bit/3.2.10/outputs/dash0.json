{
  "title": "Dash0",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0",
  "fields": [
    {
      "name": "header",
      "required": false,
      "description": "The specific header for bearer authorization, where {your-Auth-token-here} is your Dash0 Auth Token.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": "Authorization Bearer {your-Auth-token-here}",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "host",
      "required": false,
      "description": "Your Dash0 ingress endpoint.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": "ingress.eu-west-1.aws.dash0.com",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port of your Dash0 ingress endpoint.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": 443,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "metrics_uri",
      "required": false,
      "description": "Specify an optional HTTP URI for the target web server listening for metrics",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": "/v1/metrics",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "logs_uri",
      "required": false,
      "description": "Specify an optional HTTP URI for the target web server listening for logs",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": "/v1/logs",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "traces_uri",
      "required": false,
      "description": "Specify an optional HTTP URI for the target web server listening for traces",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
      "default": "/v1/traces",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/dash0#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Stream logs to Dash0 by utilizing the OpenTelemetry plugin to send data to the Dash0 log ingress."
}
