{
  "title": "Datadog",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog",
  "fields": [
    {
      "name": "host",
      "required": true,
      "description": "Required - The Datadog server where you are sending your logs.",
