      "default": "http-intake.logs.datadoghq.com",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tls",
      "required": true,
      "description": "Required - End-to-end security communications security protocol.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "default": "off",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "compress",
      "required": false,
      "description": "Recommended - compresses the payload in GZIP format, Datadog supports and recommends setting this to gzip.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "apikey",
      "required": true,
      "description": "Required - Your [Datadog API key](https://app.datadoghq.com/account/settings#api).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "proxy",
      "required": false,
      "description": "Optional - Specify an HTTP Proxy.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "provider",
      "required": false,
      "description": "To activate the remapping, specify configuration flag provider with value ecs.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "json_date_key",
