      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag_key",
      "required": false,
      "description": "The key name of tag.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "default": "tagkey",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_service",
      "required": false,
      "description": "Recommended - The human readable name for your service generating the logs (e.g.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_source",
      "required": false,
      "description": "Recommended - A human readable name for the underlying technology of your service (e.g.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_tags",
      "required": false,
      "description": "Optional - The [tags](https://docs.datadoghq.com/tagging/) you want to assign to your logs in Datadog.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_message_key",
      "required": false,
      "description": "By default, the plugin searches for the key 'log' and remap the value to the key 'message'.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_hostname",
      "required": false,
      "description": "The host the emitted logs should be associated with.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/3.2/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "header",
      "required": false,
      "description": "Add additional arbitrary HTTP header key/value pair.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/datadog#configuration-parameters",
