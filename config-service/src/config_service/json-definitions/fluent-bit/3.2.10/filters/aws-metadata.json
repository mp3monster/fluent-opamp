{
  "title": "AWS Metadata",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata",
  "fields": [
    {
      "name": "imds_version",
      "required": false,
      "description": "Specify which version of the instance metadata service to use.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": "v2",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "az",
      "required": false,
      "description": "The [availability zone](https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/using-regions-availability-zones.html); for example, \"us-east-1a\".",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "ec2_instance_id",
      "required": false,
      "description": "The EC2 instance ID.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "ec2_instance_type",
      "required": false,
      "description": "The EC2 instance type.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "private_ip",
      "required": false,
      "description": "The EC2 instance private ip.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "ami_id",
      "required": false,
      "description": "The EC2 instance image id.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "account_id",
      "required": false,
      "description": "The account ID for current EC2 instance.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "hostname",
      "required": false,
      "description": "The hostname for current EC2 instance.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "vpc_id",
      "required": false,
      "description": "The VPC ID for current EC2 instance.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tags_enabled",
      "required": true,
      "description": "Specifies if should attach EC2 instance tags.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tags_include",
      "required": true,
      "description": "Defines list of specific EC2 tag keys to inject into the logs.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "tags_exclude",
      "required": true,
      "description": "Defines list of specific EC2 tag keys not to inject into the logs.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "retry_interval_s",
      "required": false,
      "description": "Defines minimum duration between retries for fetching EC2 instance tags.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
      "default": 300,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/aws-metadata#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The AWS Filter Enriches logs with AWS Metadata."
}
