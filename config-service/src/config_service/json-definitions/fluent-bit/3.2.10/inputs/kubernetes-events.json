{
  "title": "Kubernetes Events",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events",
  "fields": [
    {
      "name": "db",
      "required": false,
      "description": "Set a database file to keep track of recorded Kubernetes events",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "db.sync",
      "required": false,
      "description": "Set a database sync method.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "normal",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "interval_sec",
      "required": false,
      "description": "Set the reconnect interval (seconds)\\",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "interval_nsec",
      "required": false,
      "description": "Set the reconnect interval (sub seconds: nanoseconds)\\",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": 500000000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "kube_url",
      "required": false,
      "description": "API Server end-point",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "<https://kubernetes.default.svc>",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_ca_file",
      "required": false,
      "description": "Kubernetes TLS CA file",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_ca_path",
      "required": false,
      "description": "Kubernetes TLS ca path",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_token_file",
      "required": false,
      "description": "Kubernetes authorization token file.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_token_ttl",
      "required": false,
      "description": "kubernetes token ttl, until it is reread from the token file.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "10m",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "kube_request_limit",
      "required": false,
      "description": "kubernetes limit parameter for events query, no limit applied when set to 0.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "kube_retention_time",
      "required": false,
      "description": "Kubernetes retention time for events.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "1h",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_namespace",
      "required": false,
      "description": "Kubernetes namespace to query events from.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tls.debug",
      "required": false,
      "description": "Debug level between 0 (nothing) and 4 (every detail).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "tls.verify",
      "required": false,
      "description": "Enable or disable verification of TLS peer certificate.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "default": "On",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tls.vhost",
      "required": false,
      "description": "Set optional TLS virtual host.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Kubernetes exports it events through the API server."
}
