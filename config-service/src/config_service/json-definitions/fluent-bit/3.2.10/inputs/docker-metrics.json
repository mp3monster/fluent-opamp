{
  "title": "Docker Log Based Metrics",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics",
  "fields": [
    {
      "name": "interval_sec",
      "required": false,
      "description": "Polling interval in seconds",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
      "default": 1,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "include",
      "required": false,
      "description": "A space-separated list of containers to include",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": " "
      }
    },
    {
      "name": "exclude",
      "required": false,
      "description": "A space-separated list of containers to exclude",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": " "
      }
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "path.containers",
      "required": false,
      "description": "Used to specify the container directory if Docker is configured with a custom \"data-root\" directory.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
      "default": "/var/lib/docker/containers",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/docker-metrics#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The plugin supports the following configuration parameters:"
}
