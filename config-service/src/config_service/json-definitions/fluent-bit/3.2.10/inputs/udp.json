{
  "title": "UDP",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp",
  "fields": [
    {
      "name": "listen",
      "required": false,
      "description": "Listener network interface.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "default": "0.0.0.0",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "UDP port where listening for connections",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "default": 5170,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "buffer_size",
      "required": false,
      "description": "Specify the maximum buffer size in KB to receive a JSON message.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "chunk_size",
      "required": true,
      "description": "By default the buffer to store the incoming JSON messages, do not allocate the maximum memory allowed, instead it allocate memory when is required.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "default": 32,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "format",
      "required": false,
      "description": "Specify the expected payload format.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "default": "JSON",
      "data_type": "enum",
      "enum_called_options": ["none", "JSON"],
      "validation_rule": { "kind": "enum", "values": ["none", "JSON"] }
    },
    {
      "name": "separator",
      "required": false,
      "description": "When the expected Format is set to none, Fluent Bit needs a separator string to split the records.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "source_address_key",
      "required": false,
      "description": "Specify the key where the source address will be injected.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/udp#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The udp input plugin allows to retrieve structured JSON or raw messages over a UDP network interface (UDP port)."
}
