{
  "title": "Elasticsearch",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch",
  "fields": [
    {
      "name": "buffer_max_size",
      "required": false,
      "description": "Set the maximum size of buffer.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "4M",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "buffer_chunk_size",
      "required": false,
      "description": "Set the buffer chunk size.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "512K",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "tag_key",
      "required": false,
      "description": "Specify a key name for extracting as a tag.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "NULL",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "meta_key",
      "required": false,
      "description": "Specify a key name for meta information.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "\"@meta\"",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "hostname",
      "required": false,
      "description": "Specify hostname or FQDN.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "\"localhost\"",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "version",
      "required": false,
      "description": "Specify Elasticsearch server version.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": "\"8.0.0\"",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/elasticsearch#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default value"
    ]
  },
  "description": "The elasticsearch input plugin handles both Elasticsearch and OpenSearch Bulk API requests."
}
