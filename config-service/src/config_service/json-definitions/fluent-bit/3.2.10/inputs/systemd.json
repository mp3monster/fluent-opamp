{
  "title": "Systemd",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd",
  "fields": [
    {
      "name": "path",
      "required": false,
      "description": "Optional path to the Systemd journal directory, if not set, the plugin will use default paths to read local-only logs.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "max_fields",
      "required": false,
      "description": "Set a maximum number of fields (keys) allowed per record.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": 8000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "max_entries",
      "required": false,
      "description": "When Fluent Bit starts, the Journal might have a high number of logs in the queue.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": 5000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "systemd_filter",
      "required": true,
      "description": "Allows to perform a query over logs that contains a specific Journald key/value pairs, e.g: _SYSTEMD_UNIT=UNIT.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "systemd_filter_type",
      "required": false,
      "description": "Define the filter type when Systemd_Filter is specified multiple times.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": "Or",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "The tag is used to route messages but on Systemd plugin there is an extra functionality: if the tag includes a star/wildcard, it will be expanded with the Systemd Unit file (_SYSTEMD_UNIT, e.g.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "db",
      "required": false,
      "description": "Specify the absolute path of a database file to keep track of Journald cursor.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "db.sync",
      "required": false,
      "description": "Set a default synchronization (I/O) method.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": "Full",
      "data_type": "enum",
      "enum_options": ["Extra", "Full", "Normal", "Off"],
      "validation_rule": {
        "kind": "enum",
        "values": ["Extra", "Full", "Normal", "Off"]
      }
    },
    {
      "name": "read_from_tail",
      "required": false,
      "description": "Start reading new entries.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": "Off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "lowercase",
      "required": false,
      "description": "Lowercase the Journald field (key).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": "Off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "strip_underscores",
      "required": false,
      "description": "Remove the leading underscore of the Journald field (key).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": "Off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/systemd#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The Systemd input plugin allows to collect log messages from the Journald daemon on Linux environments."
}
