{
  "title": "Podman Metrics",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics",
  "fields": [
    {
      "name": "scrape_interval",
      "required": false,
      "description": "Interval between each scrape of podman data (in seconds)",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": 30,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "scrape_on_start",
      "required": false,
      "description": "Should this plugin scrape podman data after it is started",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "path.config",
      "required": false,
      "description": "Custom path to podman containers configuration file",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/var/lib/containers/storage/overlay-containers/containers.json",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "path.sysfs",
      "required": false,
      "description": "Custom path to sysfs subsystem directory",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/sys/fs/cgroup",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "path.procfs",
      "required": false,
      "description": "Custom path to proc subsystem directory",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/proc",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/podman-metrics#configuration-parameters",
    "table_header": [
      "**Key**",
      "Description",
      "Default"
    ]
  },
  "description": "Monitoring of podman"
}