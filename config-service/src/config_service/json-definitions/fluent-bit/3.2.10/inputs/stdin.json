{
  "title": "Standard Input",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input",
  "fields": [
    {
      "name": "buffer_size",
      "required": true,
      "description": "Set the buffer size to read data.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "default": "16k",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "parser",
      "required": false,
      "description": "The name of the parser to invoke instead of the default JSON input parser",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "data_type": "string",
      "validation_rule": null,
      "references_parser": true
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/standard-input#configuration-parameters-a-hrefconfig-idconfiga",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The stdin plugin supports retrieving a message stream from the standard input interface (stdin) of the Fluent Bit process."
}
