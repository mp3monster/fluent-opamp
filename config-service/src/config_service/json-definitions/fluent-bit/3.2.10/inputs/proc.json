      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "interval_sec",
      "required": false,
      "description": "Interval in seconds between the service checks.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/process#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "duration"
      }
    },
    {
      "name": "interval_nsec",
      "required": false,
      "description": "Specify a nanoseconds interval for service checks, it works in conjunction with the Interval_Sec configuration key.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/process#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "duration"}
    },
    {
      "name": "alert",
      "required": false,
      "description": "If enabled, it will only generate messages if the target process is down.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/process#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "fd",
      "required": false,
      "description": "If enabled, a number of fd is appended to each records.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/process#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "mem",
      "required": false,
      "description": "If enabled, memory usage of the process is appended to each records.",
