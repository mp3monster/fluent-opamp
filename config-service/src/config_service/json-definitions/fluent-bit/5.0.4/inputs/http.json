      "required": false,
      "description": "Adds a REMOTE_ADDR field to the record.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/http#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "buffer_chunk_size",
      "required": false,
