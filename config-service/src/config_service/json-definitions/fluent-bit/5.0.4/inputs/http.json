      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/http#configuration-parameters",
      "default": "512K",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "buffer_max_size",
      "required": false,
      "description": "Specify the maximum buffer size to receive a JSON message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/http#configuration-parameters",
      "default": "4M",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "enable_health_endpoint",
      "required": false,
      "description": "Enable a GET /health endpoint for this input instance.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/http#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "http2",
      "required": false,
