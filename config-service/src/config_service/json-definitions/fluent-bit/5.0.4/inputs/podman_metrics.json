{
  "title": "Podman metrics",
  "doc_url": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics",
  "fields": [
    {
      "name": "path.config",
      "required": false,
      "description": "Custom path to the Podman containers configuration file.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/var/lib/containers/storage/overlay-containers/containers.json",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "path.procfs",
      "required": false,
      "description": "Custom path to the proc subsystem directory.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/proc",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "path.sysfs",
      "required": false,
      "description": "Custom path to the sysfs subsystem directory.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": "/sys/fs/cgroup",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "scrape_interval",
      "required": false,
      "description": "Interval between each scrape of Podman data (in seconds).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": 30,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "scrape_on_start",
      "required": false,
      "description": "Sets whether this plugin scrapes Podman data on startup.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": false,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/podman-metrics#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: Podman metrics."
}
