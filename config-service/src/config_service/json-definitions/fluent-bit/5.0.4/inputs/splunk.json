        "min": 0
      }
    },
    {
      "name": "http_server.ingress_queue_byte_limit",
      "required": false,
      "description": "Maximum size of the deferred ingress queue.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/splunk#configuration-parameters",
      "default": "256M",
      "data_type": "string",
      "validation_rule": null
