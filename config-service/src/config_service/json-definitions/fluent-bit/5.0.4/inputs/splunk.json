      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/splunk#configuration-parameters",
      "default": "512K",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "buffer_max_size",
      "required": false,
      "description": "Set the maximum buffer size to receive a JSON message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/splunk#configuration-parameters",
      "default": "4M",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "http2",
      "required": false,
      "description": "Enable HTTP/2 support.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/splunk#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
