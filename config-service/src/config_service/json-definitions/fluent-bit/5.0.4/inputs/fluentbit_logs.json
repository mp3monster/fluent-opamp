      "data_type": "string",
      "validation_rule": {
        "kind": "enum",
        "values": ["error", "warn", "info", "debug", "trace", "help"]
      }
    },
    {
      "name": "message",
      "required": false,
      "description": "The log text message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/fluentbit-logs#record-format",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "manually addressed",
    "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/fluentbit-logs#configuration-parameters"
  },
  "description": "Fluent Bit input plugin: Fluent Bit logs."
}
