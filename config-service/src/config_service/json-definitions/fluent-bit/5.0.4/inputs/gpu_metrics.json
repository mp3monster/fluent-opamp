{
  "title": "GPU metrics",
  "doc_url": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics",
  "fields": [
    {
      "name": "cards_exclude",
      "required": false,
      "description": "Pattern specifying which GPU cards to exclude from monitoring.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "cards_include",
      "required": false,
      "description": "Pattern specifying which GPU cards to monitor.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "default": "*",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "enable_power",
      "required": false,
      "description": "Enable collection of power consumption metrics (gpu_power_watts).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "enable_temperature",
      "required": false,
      "description": "Enable collection of temperature metrics (gpu_temperature_celsius).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "path_sysfs",
      "required": false,
      "description": "Path to the sysfs root directory.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "default": "/sys",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "scrape_interval",
      "required": false,
      "description": "Interval in seconds between metric collection cycles.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/gpu-metrics#configuration-parameters",
      "default": 5,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
