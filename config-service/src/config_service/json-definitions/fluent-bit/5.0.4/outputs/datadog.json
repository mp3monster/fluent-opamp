      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "default": "timestamp",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "provider",
      "required": false,
      "description": "To activate remapping, specify the configuration flag provider with the value ecs.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "proxy",
      "required": false,
      "description": "Specifies an HTTP proxy.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag_key",
      "required": false,
      "description": "The key name of tag.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "default": "tagkey",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tls",
      "required": false,
      "description": "End-to-end security communications protocol.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "default": "off",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
