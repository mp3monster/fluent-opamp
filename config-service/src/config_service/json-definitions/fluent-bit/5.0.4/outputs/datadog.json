    {
      "name": "dd_message_key",
      "required": false,
      "description": "By default, the plugin searches for the key log and remaps the value to the key message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "default": "log",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_service",
      "required": false,
      "description": "Recommended.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
