    {
      "name": "dd_source",
      "required": false,
      "description": "Recommended.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/datadog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dd_tags",
      "required": false,
      "description": "The [tags](https://docs.datadoghq.com/getting_started/tagging/) you want to assign to your logs in Datadog.",
