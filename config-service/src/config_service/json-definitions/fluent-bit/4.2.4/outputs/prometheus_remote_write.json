{
  "title": "Prometheus remote write",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write",
  "fields": [
    {
      "name": "add_label",
      "required": false,
      "description": "This lets you add custom labels to all metrics sent by the prometheus_remote_write output.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "aws_auth",
      "required": false,
      "description": "Enable AWS SigV4 authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "aws_external_id",
      "required": false,
      "description": "External ID for the AWS IAM Role specified with aws_role_arn, used by SigV4 authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "aws_profile",
      "required": false,
      "description": "AWS profile name.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "aws_region",
      "required": false,
      "description": "Region of your Amazon Managed Service for Prometheus workspace.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "aws_role_arn",
      "required": false,
      "description": "AWS IAM Role to assume, used by SigV4 authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "aws_service",
      "required": false,
