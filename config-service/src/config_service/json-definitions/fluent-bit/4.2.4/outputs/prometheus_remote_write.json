    {
      "name": "http_user",
      "required": false,
      "description": "Basic Auth username.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "log_response_payload",
      "required": false,
      "description": "Log the response payload within the Fluent Bit log.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/prometheus-remote-write#configuration-parameters",
