{
  "title": "Google Cloud BigQuery",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery",
  "fields": [
    {
      "name": "aws_region",
      "required": false,
      "description": "Used to construct a regional endpoint for AWS STS to verify AWS credentials obtained by Fluent Bit.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "dataset_id",
      "required": true,
      "description": "The dataset ID of the BigQuery dataset to write into.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "enable_identity_federation",
      "required": false,
      "description": "Enables workload identity federation as an alternative authentication method.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": "Off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "google_service_account",
      "required": true,
      "description": "The email address of the Google service account to impersonate.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "google_service_credentials",
      "required": false,
      "description": "Absolute path to a Google Cloud credentials JSON file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": "Value of the environment variable `$GOOGLE_SERVICE_CREDENTIALS`.",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "ignore_unknown_values",
      "required": false,
      "description": "Accept rows that contain values that don't match the schema.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": "Off",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "pool_id",
      "required": false,
      "description": "GCP workload identity pool where the identity provider was created.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "project_id",
      "required": false,
      "description": "The project ID containing the BigQuery dataset to stream into.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": "Value of the `project_id` in the credentials file.",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "project_number",
      "required": false,
      "description": "GCP project number where the identity provider was created.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "provider_id",
      "required": false,
      "description": "GCP workload identity provider.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "service_account_email",
      "required": false,
      "description": "The service account email address.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "service_account_secret",
      "required": false,
      "description": "The service account private key.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "skip_invalid_rows",
      "required": false,
      "description": "Insert all valid rows of a request, even if invalid rows exist.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": "Off",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "table_id",
      "required": true,
      "description": "The table ID of the BigQuery table to write into.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/4.2/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/bigquery#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "The Google Cloud BigQuery output plugin is an experimental plugin that lets you stream records into the Google Cloud BigQuery service."
}
