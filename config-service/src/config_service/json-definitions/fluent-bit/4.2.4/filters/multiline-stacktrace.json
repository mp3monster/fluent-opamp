{
  "title": "Multiline",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace",
  "fields": [
    {
      "name": "buffer",
      "required": false,
      "description": "Enable buffered mode.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "debug_flush",
      "required": false,
      "description": "Enable debug logging for flush operations.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "emitter_mem_buf_limit",
      "required": false,
      "description": "Set a limit on the amount of memory the emitter can consume if the outputs provide backpressure.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "emitter_name",
      "required": false,
      "description": "Name for the emitter input instance which re-emits the completed records at the beginning of the pipeline.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "emitter_storage.type",
      "required": false,
      "description": "The storage type for the emitter input instance.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "flush_ms",
      "required": false,
      "description": "Flush time for pending multiline records.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "mode",
      "required": false,
      "description": "Mode can be parser for regular expression concatenation, or partial_message to concatenate split Docker logs.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "multiline.key_content",
      "required": false,
      "description": "Key name that holds the content to process.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "multiline.parser",
      "required": false,
      "description": "Specify one or multiple [Multiline Parser definitions](/manual/4.2/data-pipeline/parsers/multiline-parsing.md) to apply to the content.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/multiline-stacktrace#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
