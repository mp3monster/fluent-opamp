{
  "title": "CheckList",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist",
  "fields": [
    {
      "name": "file",
      "required": false,
      "description": "The single value file that Fluent Bit will use as a lookup table to determine if the specified lookup_key exists.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "ignore_case",
      "required": false,
      "description": "Compare strings by ignoring case.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "lookup_key",
      "required": false,
      "description": "The specific key to look up and determine if it exists.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "default": "log",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "mode",
      "required": false,
      "description": "Set the check mode.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "default": "exact",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "print_query_time",
      "required": false,
      "description": "Print to stdout the elapsed query time for every matched record.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "record",
      "required": false,
      "description": "The record to add if the lookup_key is found in the specified file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/checklist#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
