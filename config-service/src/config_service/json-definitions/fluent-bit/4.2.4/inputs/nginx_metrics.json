{
  "title": "NGINX exporter metrics",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx",
  "fields": [
    {
      "name": "host",
      "required": false,
      "description": "Name of the target host or IP address.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": "localhost",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "nginx_plus",
      "required": false,
      "description": "Turn on NGINX Plus mode.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "port",
      "required": false,
      "description": "Port of the target NGINX service to connect to.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": 80,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "scrape_interval",
      "required": false,
      "description": "The interval to scrape metrics from the NGINX service.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": "5s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "status_url",
      "required": false,
      "description": "The URL of the stub status handler.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": "/status",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/4.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/nginx#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: NGINX exporter metrics."
}
