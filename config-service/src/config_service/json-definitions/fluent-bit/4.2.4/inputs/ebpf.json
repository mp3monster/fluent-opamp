{
  "title": "eBPF",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/ebpf",
  "fields": [
    {
      "name": "poll_ms",
      "required": false,
      "description": "Set the polling interval in milliseconds for collecting events from the ring buffer.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/ebpf#configuration-parameters",
      "default": 1000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "ringbuf_map_name",
      "required": false,
      "description": "Set the name of the eBPF ring buffer map to read events from.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/ebpf#configuration-parameters",
      "default": "events",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "trace",
      "required": false,
      "description": "Set the eBPF trace to enable (for example, trace_bind, trace_malloc, trace_signal, trace_tcp, trace_vfs).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/ebpf#configuration-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "enum",
        "values": ["trace_signal", "trace_malloc", "trace_bind", "trace_tcp", "trace_vfs"]
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/ebpf#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: eBPF."
}
