{
  "title": "Prometheus text file",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile",
  "fields": [
    {
      "name": "alias",
      "required": false,
      "description": "Sets an alias.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "log_level",
      "required": false,
      "description": "Specifies the log level for input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": "info",
      "data_type": "enum",
      "validation_rule": null,
      "enum_options": [
        "off",
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    {
      "name": "log_suppress_interval",
      "required": false,
      "description": "Suppresses log messages from input plugin that appear similar within a specified time interval.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "mem_buf_limit",
      "required": false,
      "description": "Set a memory buffer limit for the input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "path",
      "required": false,
      "description": "Comma-separated list of files or glob patterns to read.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "routable",
      "required": false,
      "description": "If set to true, the data generated by the plugin will be routable, meaning that it can be forwarded to other plugins or outputs.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "scrape_interval",
      "required": false,
      "description": "Interval between file scans.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": "10s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "storage.pause_on_chunks_overlimit",
      "required": false,
      "description": "Enable pausing on an input when they reach their chunks limit.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.type",
      "required": false,
      "description": "Sets the storage type for this input, one of: filesystem, memory or memrb.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": "memory",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Set a tag for the events generated by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "thread.ring_buffer.capacity",
      "required": false,
      "description": "Set custom ring buffer capacity when the input runs in threaded mode.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": 1024,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "thread.ring_buffer.window",
      "required": false,
      "description": "Set custom ring buffer window percentage for threaded inputs.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": 5,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Enable threading on an input.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: Prometheus text file."
}
