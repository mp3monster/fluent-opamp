{
  "type": "object",
  "title": "Lua",
  "properties": {
    "name": {
      "type": "string",
      "const": "lua",
      "title": "Plugin"
    },
    "call": {
      "type": "string",
      "description": "The Lua function name that will be triggered to do filtering.",
