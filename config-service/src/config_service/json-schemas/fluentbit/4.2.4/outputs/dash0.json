{
  "type": "object",
  "title": "Dash0",
  "properties": {
    "name": {
      "type": "string",
      "const": "dash0",
      "title": "Plugin"
    },
    "header": {
      "type": "string",
      "description": "The specific header for bearer authorization, where {your-Auth-token-here} is your Dash0 Auth Token.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "Authorization Bearer {your-Auth-token-here}"
    },
    "host": {
      "type": "string",
      "description": "Your Dash0 ingress endpoint.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "ingress.eu-west-1.aws.dash0.com"
    },
    "logs_uri": {
      "type": "string",
      "description": "Specify an optional HTTP URI for the target web server listening for logs.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/v1/logs"
    },
    "metrics_uri": {
      "type": "string",
      "description": "Specify an optional HTTP URI for the target web server listening for metrics.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/v1/metrics"
    },
    "port": {
      "type": "integer",
      "description": "TCP port of your Dash0 ingress endpoint.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 443
    },
    "traces_uri": {
      "type": "string",
      "description": "Specify an optional HTTP URI for the target web server listening for traces.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dash0#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/v1/traces"
    },
    "match": {
      "type": "string",
