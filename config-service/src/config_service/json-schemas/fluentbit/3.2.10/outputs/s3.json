      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "us-east-1"
    },
    "bucket": {
      "type": "string",
      "description": "S3 Bucket name",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/s3#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "json_date_key": {
      "type": "string",
      "description": "Specify the time key name in the output record.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/s3#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "date"
