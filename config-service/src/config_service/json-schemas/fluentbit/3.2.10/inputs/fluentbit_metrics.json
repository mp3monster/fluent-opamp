{
  "type": "object",
  "title": "Fluent Bit Metrics",
  "properties": {
    "name": {
      "type": "string",
      "const": "fluentbit_metrics",
      "title": "Plugin"
    },
    "scrape_interval": {
      "type": "string",
      "description": "The rate at which metrics are collected from the host operating system",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/fluentbit-metrics#configuration",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "2 seconds"
    },
    "scrape_on_start": {
      "type": "boolean",
      "description": "Scrape metrics upon start, useful to avoid waiting for 'scrape_interval' for the first round of metrics.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/fluentbit-metrics#configuration",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "threaded": {
      "type": "boolean",
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/fluentbit-metrics#configuration",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "tag": {
      "type": "string",
      "description": "Tag assigned to records emitted by this input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "tag"
  ],
  "additionalProperties": false
}
