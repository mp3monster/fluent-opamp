{
  "type": "object",
  "title": "Kubernetes Events",
  "properties": {
    "name": {
      "type": "string",
      "const": "kubernetes-events",
      "title": "Plugin"
    },
    "db": {
      "type": "string",
      "description": "Set a database file to keep track of recorded Kubernetes events",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "db.sync": {
      "type": "string",
      "description": "Set a database sync method.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "normal"
    },
    "interval_sec": {
      "type": "integer",
      "description": "Set the reconnect interval (seconds)\\",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "interval_nsec": {
      "type": "integer",
      "description": "Set the reconnect interval (sub seconds: nanoseconds)\\",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 500000000
    },
    "kube_url": {
      "type": "string",
      "description": "API Server end-point",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "<https://kubernetes.default.svc>"
    },
    "kube_ca_file": {
      "type": "string",
      "description": "Kubernetes TLS CA file",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    },
    "kube_ca_path": {
      "type": "string",
      "description": "Kubernetes TLS ca path",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "kube_token_file": {
      "type": "string",
      "description": "Kubernetes authorization token file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/token"
    },
    "kube_token_ttl": {
      "type": "string",
      "description": "kubernetes token ttl, until it is reread from the token file.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "10m"
    },
    "kube_request_limit": {
      "type": "integer",
      "description": "kubernetes limit parameter for events query, no limit applied when set to 0.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "kube_retention_time": {
      "type": "string",
      "description": "Kubernetes retention time for events.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "1h"
    },
    "kube_namespace": {
      "type": "string",
      "description": "Kubernetes namespace to query events from.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tls.debug": {
      "type": "integer",
      "description": "Debug level between 0 (nothing) and 4 (every detail).",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "tls.verify": {
      "type": "boolean",
      "description": "Enable or disable verification of TLS peer certificate.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": "On"
    },
    "tls.vhost": {
      "type": "string",
      "description": "Set optional TLS virtual host.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kubernetes-events#configuration",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tag": {
      "type": "string",
      "description": "Tag assigned to records emitted by this input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "tag"
  ],
  "additionalProperties": false
}
