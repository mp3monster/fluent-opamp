      "type": "string",
      "const": "flowcounter",
      "title": "Plugin"
    },
    "event_based": {
      "type": "boolean",
      "description": "When enabled, use the timestamp from the log event for time bucketing instead of the current wall-clock time.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/flowcounter#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": false
    },
    "unit": {
      "type": "string",
      "description": "The unit of duration.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/flowcounter#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "minute"
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/flowcounter#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match": {
      "type": "string",
