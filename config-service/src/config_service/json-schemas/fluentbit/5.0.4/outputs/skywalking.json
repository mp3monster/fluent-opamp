{
  "type": "object",
  "title": "Apache SkyWalking",
  "properties": {
    "name": {
      "type": "string",
      "const": "skywalking",
      "title": "Plugin"
    },
    "auth_token": {
      "type": "string",
      "description": "Authentication token if needed for Apache SkyWalking OAP.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "host": {
      "type": "string",
      "description": "Hostname of Apache SkyWalking OAP.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "description": "TCP port of the Apache SkyWalking OAP.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 12800
    },
    "svc_inst_name": {
      "type": "string",
      "description": "Service instance name of Fluent Bit.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "fluent-bit"
    },
    "svc_name": {
      "type": "string",
      "description": "Service name that Fluent Bit belongs to.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false,
      "default": "sw-service"
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/skywalking#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
