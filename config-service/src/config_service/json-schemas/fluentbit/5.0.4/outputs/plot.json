{
  "type": "object",
  "title": "Plot",
  "properties": {
    "name": {
      "type": "string",
      "const": "plot",
      "title": "Plugin"
    },
    "file": {
      "type": "string",
      "description": "Set filename to store the records.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/plot#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "key": {
      "type": "string",
      "description": "Specify the key name from the record to extract as the value.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/plot#configuration-parameters",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "workers": {
      "type": "integer",
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/plot#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "match": {
      "type": "string",
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "match_regex": {
      "type": "string",
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "processors": {
      "$ref": "../processors.json"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "key"
  ],
  "additionalProperties": false
}
