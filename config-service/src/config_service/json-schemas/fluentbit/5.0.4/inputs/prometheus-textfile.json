      "title": "Plugin"
    },
    "alias": {
      "type": "string",
      "description": "Sets an alias.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "log_level": {
      "type": "string",
      "description": "Specifies the log level for input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "enum",
      "x-references-parser": false,
      "enum": [
        "off",
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ],
      "default": "info"
    },
    "log_suppress_interval": {
      "type": "integer",
      "description": "Suppresses log messages from input plugin that appear similar within a specified time interval.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "mem_buf_limit": {
      "type": "integer",
      "description": "Set a memory buffer limit for the input plugin.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "integer",
      "x-references-parser": false,
      "default": 0
    },
    "path": {
      "type": "array",
      "description": "Comma-separated list of files or glob patterns to read.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "list",
      "x-references-parser": false
    },
    "routable": {
      "type": "boolean",
      "description": "If set to true, the data generated by the plugin will be routable, meaning that it can be forwarded to other plugins or outputs.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "boolean",
      "x-references-parser": false,
      "default": true
    },
    "scrape_interval": {
      "type": "string",
      "description": "Interval between file scans.",
      "x-doc-reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/prometheus-textfile#configuration-parameters",
      "x-doc-required": false,
      "x-config-data-type": "duration",
      "x-references-parser": false,
      "default": "10s"
    },
