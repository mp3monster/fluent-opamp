      "x-doc-required": false,
      "x-config-data-type": "enum",
      "x-references-parser": false,
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ],
      "default": "info"
    },
    "@label": {
      "type": "string",
