{
  "type": "object",
  "title": "sample",
  "properties": {
    "name": {
      "type": "string",
      "const": "sample",
      "title": "Plugin"
    },
    "@id": {
      "type": "string",
      "description": "Unique identifier for the plugin instance.",
      "x-doc-reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "@log_level": {
      "type": "string",
      "description": "Plugin-specific log level that overrides the global system log level.",
      "x-doc-reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "x-doc-required": false,
      "x-config-data-type": "enum",
      "x-references-parser": false,
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ],
      "default": "info"
    },
    "@label": {
      "type": "string",
      "description": "Routes emitted events to a named label.",
      "x-doc-reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "x-doc-required": false,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "tag": {
      "type": "string",
      "description": "Tag assigned to generated events.",
      "x-doc-reference": "https://docs.fluentd.org/input/sample",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "sample": {
      "type": "string",
      "description": "Sample payload emitted at each interval.",
      "x-doc-reference": "https://docs.fluentd.org/input/sample",
      "x-doc-required": true,
      "x-config-data-type": "string",
      "x-references-parser": false
    },
    "rate": {
      "type": "string",
      "description": "Interval between generated events.",
      "x-doc-reference": "https://docs.fluentd.org/input/sample",
      "x-doc-required": false,
      "x-config-data-type": "time",
      "x-references-parser": false,
      "default": "1s"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "comment_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_comment_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "tag",
    "sample"
  ],
  "additionalProperties": false
}
