{
  "title": "record_transformer",
  "doc_url": "https://docs.fluentd.org/filter/record_transformer",
  "description": "Adds, removes, or rewrites record fields.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "called_enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "enable_ruby",
      "required": false,
      "description": "Enable embedded Ruby expressions inside the record section.",
      "reference": "https://docs.fluentd.org/filter/record_transformer",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "auto_typecast",
      "required": false,
      "description": "Cast evaluated strings into numeric or boolean types when possible.",
      "reference": "https://docs.fluentd.org/filter/record_transformer",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "renew_record",
      "required": false,
      "description": "Create a fresh output record rather than mutating the input record.",
      "reference": "https://docs.fluentd.org/filter/record_transformer",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "remove_keys",
      "required": false,
      "description": "Comma-separated list of record keys removed after transformation.",
      "reference": "https://docs.fluentd.org/filter/record_transformer",
      "data_type": "list",
      "validation_rule": {
        "kind": "list"
      }
    },
    {
      "name": "keep_keys",
      "required": false,
      "description": "List of record keys preserved when renew_record is true.",
      "reference": "https://docs.fluentd.org/filter/record_transformer",
      "data_type": "list",
      "validation_rule": {
        "kind": "list"
      }
    }
  ],
  "allowed_children": [
    {
      "section": "record",
      "cardinality": {
        "minimum": 0,
        "maximum": 1
      }
    }
  ],
  "directive_argument": {
    "name": "match",
    "required": true,
    "description": "Tag pattern selecting events for this filter.",
    "reference": "https://docs.fluentd.org/configuration/config-file",
    "data_type": "string",
    "validation_rule": {
      "kind": "regex_string"
    }
  }
}
