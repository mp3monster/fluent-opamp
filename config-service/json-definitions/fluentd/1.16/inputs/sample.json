{
  "title": "sample",
  "doc_url": "https://docs.fluentd.org/input/sample",
  "description": "Generates sample events for testing pipelines.",
  "fields": [
    {
      "name": "@id",
      "required": false,
      "description": "Unique identifier for the plugin instance.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "@log_level",
      "required": false,
      "description": "Plugin-specific log level that overrides the global system log level.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "called_enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "@label",
      "required": false,
      "description": "Routes emitted events to a named label.",
      "reference": "https://docs.fluentd.org/configuration/plugin-common-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to generated events.",
      "reference": "https://docs.fluentd.org/input/sample",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "sample",
      "required": true,
      "description": "Sample payload emitted at each interval.",
      "reference": "https://docs.fluentd.org/input/sample",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "rate",
      "required": false,
      "description": "Interval between generated events.",
      "reference": "https://docs.fluentd.org/input/sample",
      "data_type": "time",
      "validation_rule": null,
      "default": "1s"
    }
  ]
}
