{
  "catalog_type": "service-options",
  "schema_version": "1.0.0",
  "engine": "fluentd",
  "fluentd_version": "1.8",
  "section": "service",
  "render_as": "system",
  "cardinality": {
    "minimum": 0,
    "maximum": 1
  },
  "description": "Global Fluentd system/service settings rendered as the <system> directive.",
  "options": [
    {
      "name": "workers",
      "required": false,
      "description": "Number of worker processes.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1
      },
      "default": 1
    },
    {
      "name": "root_dir",
      "required": false,
      "description": "Root directory used for buffers, storage, and other generated files.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "log_level",
      "required": false,
      "description": "Global Fluentd log level.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "default": "info",
      "called_enum_options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    {
      "name": "suppress_repeated_stacktrace",
      "required": false,
      "description": "Suppress repeated stacktraces in Fluentd logs.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "emit_error_log_interval",
      "required": false,
      "description": "Minimum interval between repeated error log messages.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "time",
      "validation_rule": null
    },
    {
      "name": "suppress_config_dump",
      "required": false,
      "description": "Avoid dumping the full loaded config into startup logs.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "without_source",
      "required": false,
      "description": "Start Fluentd even when no source directives are configured.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "process_name",
      "required": false,
      "description": "Override the supervisor and worker process name.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "rpc_endpoint",
      "required": false,
      "description": "RPC endpoint path or address used for runtime control.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "enable_get_dump",
      "required": false,
      "description": "Enable the /api/plugins.json dump endpoint on monitor_agent.",
      "reference": "https://docs.fluentd.org/deployment/system-config",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    }
  ]
}
