        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "splunk_token",
      "required": false,
      "description": "Specify the authentication token for the HTTP Event Collector interface.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/splunk#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
