      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "database",
      "required": false,
      "description": "Specify the name of your target database.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/treasure-data#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "region",
      "required": false,
      "description": "Set the service region.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/treasure-data#configuration-parameters",
      "default": "US",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "table",
      "required": false,
      "description": "Specify the name of your target table where the records will be stored.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/treasure-data#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
