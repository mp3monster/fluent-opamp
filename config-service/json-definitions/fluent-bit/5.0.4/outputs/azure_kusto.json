      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "net.max_worker_connections",
      "required": false,
      "description": "Set the maximum number of active TCP connections that can be used per worker thread.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
