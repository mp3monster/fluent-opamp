      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "net.proxy_env_ignore",
      "required": false,
      "description": "Ignore the environment variables HTTP_PROXY, HTTPS_PROXY and NO_PROXY when set.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.source_address",
      "required": false,
      "description": "Specify network address to bind for data traffic.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "net.tcp_keepalive",
      "required": false,
      "description": "Enable or disable Keepalive support.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.tcp_keepalive_interval",
      "required": false,
      "description": "Interval between TCP keepalive probes when no response is received on a keepidle probe.",
