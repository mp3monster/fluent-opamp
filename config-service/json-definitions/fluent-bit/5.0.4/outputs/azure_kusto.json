{
  "title": "Azure Data Explorer",
  "doc_url": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto",
  "fields": [
    {
      "name": "alias",
      "required": false,
      "description": "Sets an alias, use to define multiple instances of the same output plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "auth_type",
      "required": false,
      "description": "Set the authentication type: service_principal, managed_identity, or workload_identity.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "service_principal",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "azure_kusto_buffer_key",
      "required": true,
      "description": "When buffering is true, set the Azure Kusto buffer key which must be specified when using multiple instances of Azure Kusto output plugin and buffering is enabled.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "key",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "blob_uri_length",
      "required": false,
      "description": "Set the length of generated blob URI before ingesting to Kusto.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": 64,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "buffer_dir",
      "required": false,
      "description": "When buffering is true, specifies the location of directory where the buffered data will be stored.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "/tmp/fluent-bit/azure-kusto/",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "buffer_file_delete_early",
      "required": false,
      "description": "When buffering is true, whether to delete the buffered file early after successful blob creation.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "buffering_enabled",
      "required": false,
      "description": "Enable buffering into disk before ingesting into Azure Kusto.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "client_id",
      "required": true,
      "description": "Required if managed_identity_client_id isn't set.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "client_secret",
      "required": false,
      "description": "Set the client secret (Application Password) of the AAD application used for authentication.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "compression_enabled",
      "required": false,
      "description": "If enabled, sends compressed HTTP payload (gzip) to Kusto.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "database_name",
      "required": false,
      "description": "The database name.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "delete_on_max_upload_error",
      "required": false,
      "description": "When buffering is true, whether to delete the buffer file on maximum upload errors.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "host",
      "required": false,
      "description": "IP address or hostname of the target HTTP server.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "127.0.0.1",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "include_tag_key",
      "required": false,
      "description": "If enabled, a tag is appended to output.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "include_time_key",
      "required": false,
      "description": "If enabled, a timestamp is appended to output.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "ingestion_endpoint",
      "required": false,
      "description": "The cluster's ingestion endpoint, usually in the form https://ingest-cluster_name.region.kusto.windows.net.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "ingestion_endpoint_connect_timeout",
      "required": false,
      "description": "The connection timeout of various Kusto endpoints in seconds.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": 60,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "ingestion_mapping_reference",
      "required": false,
      "description": "The name of a [JSON ingestion mapping](https://docs.microsoft.com/en-us/azure/data-explorer/kusto/management/mappings#json-mapping) that will be used to map the ingested payload into the table columns.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "ingestion_resources_refresh_interval",
      "required": false,
      "description": "Set the Azure Kusto ingestion resources refresh interval.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": 3600,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "io_timeout",
      "required": false,
      "description": "Configure the HTTP IO timeout for uploads.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "60s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "log_key",
      "required": false,
      "description": "Key name of the log content.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "log",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "log_level",
      "required": false,
      "description": "Specifies the log level for output plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "info",
      "data_type": "enum",
      "validation_rule": null,
      "called_enum_options": [
        "off",
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    {
      "name": "log_supress_interval",
      "required": false,
      "description": "Suppresses log messages from output plugin that appear similar within a specified time interval.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Set a tag pattern to match records that output should process.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Set a regular expression to match tags for output routing.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "net.connect_timeout",
      "required": false,
      "description": "Set maximum time allowed to establish a connection, this time includes the TLS handshake.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "10s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "net.connect_timeout_log_error",
      "required": false,
      "description": "On connection timeout, specify if it should log an error.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.dns.mode",
      "required": false,
      "description": "Select the primary DNS connection type (TCP or UDP).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "UDP",
          "TCP"
        ]
      },
      "called_enum_options": [
        "UDP",
        "TCP"
      ]
    },
    {
      "name": "net.dns.prefer_ipv4",
      "required": false,
      "description": "Select the primary DNS resolver type (LEGACY or ASYNC).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.dns.prefer_ipv6",
      "required": false,
      "description": "Prioritize IPv6 DNS results when trying to establish a connection.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.dns.resolver",
      "required": false,
      "description": "Select the primary DNS resolver type (LEGACY or ASYNC).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "data_type": "enum",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "LEGACY",
          "ASYNC"
        ]
      },
      "called_enum_options": [
        "LEGACY",
        "ASYNC"
      ],
      "default": "LEGACY"
    },
    {
      "name": "net.io_timeout",
      "required": false,
      "description": "Set maximum time a connection can stay idle while assigned.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": "0s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "net.keepalive",
      "required": false,
      "description": "Enable or disable Keepalive support.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.keepalive_idle_timeout",
      "required": false,
      "description": "Set maximum time allowed for an idle Keepalive connection..",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "net.keepalive_max_recycle",
      "required": false,
      "description": "Set maximum number of times a keepalive connection can be used before it's retried.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/azure_kusto#configuration-parameters",
