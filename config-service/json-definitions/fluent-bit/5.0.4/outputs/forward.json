{
  "title": "Forward",
  "doc_url": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward",
  "fields": [
    {
      "name": "host",
      "required": false,
      "description": "Target host where Fluent Bit or Fluentd are listening for Forward messages.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": "127.0.0.1",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port of the target service.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": 24224,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "time_as_integer",
      "required": false,
      "description": "Set timestamps in integer format.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "upstream",
      "required": false,
      "description": "If Forward connects to an upstream definition instead of a basic host, this property defines the absolute path for the upstream configuration file.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "unix_path",
      "required": false,
      "description": "Specify the path to a Unix socket to send a Forward message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": false,
      "description": "Overwrite the tag as Fluent Bit transmits.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "send_options",
      "required": false,
      "description": "Always send Forward protocol options, including \"size\".",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "require_ack_response",
      "required": false,
      "description": "Send the chunk option and wait for an ack response from the server.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "compress",
      "required": false,
      "description": "Set to gzip to enable gzip compression.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "fluentd_compat",
      "required": false,
      "description": "Send metrics and traces using a Fluentd-compatible format.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "retain_metadata_in_forward_mode",
      "required": false,
      "description": "Retain metadata when operating in forward mode.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "add_option",
      "required": false,
      "description": "Add an extra Forward protocol option.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
      "default": 2,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/data-pipeline/outputs/forward#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit output plugin: Forward."
}
