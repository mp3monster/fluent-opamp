{
  "title": "UDP",
  "doc_url": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp",
  "fields": [
    {
      "name": "buffer_size",
      "required": false,
      "description": "Specify the maximum buffer size in KB to receive a JSON message.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": "chunk_size",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "chunk_size",
      "required": true,
      "description": "The default buffer to store incoming JSON messages.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": 32,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "format",
      "required": false,
      "description": "Specify the expected payload format.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": "json",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "listen",
      "required": false,
      "description": "Listener network interface.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": "0.0.0.0",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "parser",
      "required": false,
      "description": "Optional [parser](/manual/data-pipeline/parsers.md) for line-delimited records.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null,
      "references_parser": true
    },
    {
      "name": "port",
      "required": false,
      "description": "UDP port used to listen for connections.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": 5170,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "separator",
      "required": false,
      "description": "When format is set to none, Fluent Bit needs a separator string to split the records.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": "LF` or `0x10` (break line)",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "source_address_key",
      "required": false,
      "description": "Specify the key where the source address will be injected.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": false,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/udp#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: UDP."
}
