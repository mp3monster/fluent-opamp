      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "payload_key",
      "required": false,
      "description": "Field name where the MQTT message payload will be stored in the output record.",
      "reference": "https://docs.fluentbit.io/manual/data-pipeline/inputs/mqtt#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
