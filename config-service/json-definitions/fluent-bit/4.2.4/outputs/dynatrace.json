{
  "title": "Dynatrace",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace",
  "fields": [
    {
      "name": "allow_duplicated_headers",
      "required": false,
      "description": "Specifies duplicated header use.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "format",
      "required": false,
      "description": "The data format to be used in the HTTP request body.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "json",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "header",
      "required": false,
      "description": "The specific header for content-type.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "Content-Type application/json; charset=utf-8",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "host",
      "required": false,
      "description": "Your Dynatrace environment hostname where {your-environment-id} is your environment ID.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "{your-environment-id}.live.dynatrace.com",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "json_date_format",
      "required": false,
      "description": "Date format standard for JSON.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "iso8601",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "json_date_key",
      "required": false,
      "description": "Field name specifying message timestamp.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "timestamp",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port of your Dynatrace host.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": 443,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "tls",
      "required": false,
      "description": "Specify to use TLS.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "on",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tls.verify",
      "required": false,
      "description": "TLS verification.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "on",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "uri",
      "required": false,
      "description": "Specify the HTTP URI for Dynatrace log ingest API.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
      "default": "/api/v2/logs/ingest",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/dynatrace#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Stream logs to Dynatrace by utilizing the http plugin to send data to the Dynatrace generic log ingest API."
}
