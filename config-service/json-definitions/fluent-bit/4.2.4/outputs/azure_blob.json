      "name": "upload_part_freshness_limit",
      "required": false,
      "description": "Maximum lifespan of an uncommitted file part.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "6D",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "upload_parts_timeout",
      "required": false,
      "description": "Timeout for uploading parts of a blob file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "10M",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "upload_timeout",
      "required": false,
      "description": "Optional.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "30m",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
