{
  "title": "Azure Blob",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob",
  "fields": [
    {
      "name": "account_name",
      "required": false,
      "description": "Azure Storage account name.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "auth_type",
      "required": false,
      "description": "Specify the type to authenticate against the service.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "key",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "auto_create_container",
      "required": false,
      "description": "If container_name doesn't exist in the remote service, enabling this option handles the exception and auto-creates the container.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "azure_blob_buffer_key",
      "required": false,
      "description": "Set the Azure Blob buffer key which needs to be specified when using multiple instances of Azure Blob output plugin and buffering is enabled.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "key",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "blob_type",
      "required": false,
      "description": "Specify the desired blob type.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "appendblob",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "blob_uri_length",
      "required": false,
      "description": "Set the length of the generated blob URI used when creating and uploading objects to Azure Blob Storage.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": 64,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "buffer_dir",
      "required": false,
      "description": "Specifies the location of directory where the buffered data will be stored.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "/tmp/fluent-bit/azure-blob/",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "buffer_file_delete_early",
      "required": false,
      "description": "Whether to delete the buffered file early after successful blob creation.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "buffering_enabled",
      "required": false,
      "description": "Enable buffering into disk before ingesting into Azure Blob.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "compress",
      "required": false,
      "description": "Sets payload compression in network transfer.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "compress_blob",
      "required": false,
      "description": "Enables compression in the final blockblob file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "configuration_endpoint_bearer_token",
      "required": false,
      "description": "Bearer token for the configuration endpoint.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "configuration_endpoint_password",
      "required": false,
      "description": "Basic authentication password for the configuration endpoint.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "configuration_endpoint_url",
      "required": false,
      "description": "Configuration endpoint URL.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "configuration_endpoint_username",
      "required": false,
      "description": "Basic authentication username for the configuration endpoint.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "container_name",
      "required": false,
      "description": "Name of the container that will contain the blobs.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "database_file",
      "required": false,
      "description": "Absolute path to a database file used to store blob file contexts.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "date_key",
      "required": false,
      "description": "Key name used to store the record timestamp.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "@timestamp",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "delete_on_max_upload_error",
      "required": false,
      "description": "Whether to delete the buffer file on maximum upload errors.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "emulator_mode",
      "required": false,
      "description": "To send data to an Azure emulator service like [Azurite](https://github.com/Azure/Azurite), enable this option to format the requests in the expected format.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "endpoint",
      "required": false,
      "description": "When using an emulator, this option lets you specify the absolute HTTP address of such service.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
