      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "shared_key",
      "required": false,
      "description": "Specify the Azure Storage Shared Key to authenticate against the service.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
