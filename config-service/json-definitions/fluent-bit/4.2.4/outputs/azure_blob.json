      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "25M",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "path",
      "required": false,
      "description": "Optional.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "sas_token",
      "required": false,
      "description": "Specify the Azure Storage shared access signatures to authenticate against the service.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
