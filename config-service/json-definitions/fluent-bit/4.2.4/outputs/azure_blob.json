      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "tls",
      "required": false,
      "description": "Enable or disable TLS encryption.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "off",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
