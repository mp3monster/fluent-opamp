      "required": false,
      "description": "Maximum number of delivery attempts for a file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": 1,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "io_timeout",
      "required": false,
      "description": "HTTP IO timeout.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": "60s",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "part_delivery_attempt_limit",
      "required": false,
      "description": "Maximum number of delivery attempts for a file part.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/outputs/azure_blob#configuration-parameters",
      "default": 1,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "part_size",
