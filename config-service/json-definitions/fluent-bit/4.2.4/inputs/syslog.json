{
  "title": "Syslog",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog",
  "fields": [
    {
      "name": "buffer_chunk_size",
      "required": false,
      "description": "Set the buffer size to store incoming syslog messages.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": "32KB",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "buffer_max_size",
      "required": false,
      "description": "Specify the maximum buffer size to receive a syslog message.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "format",
      "required": false,
      "description": "Specify the TCP framing format.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": "newline",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "listen",
      "required": false,
      "description": "If mode is set to tcp or udp, specify the network interface to bind.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": "0.0.0.0",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "mode",
      "required": false,
      "description": "Defines transport protocol mode: UDP over Unix socket (unix_udp), TCP over Unix socket (unix_tcp), tcp, or udp",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": "unix_udp",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "parser",
      "required": false,
      "description": "Specify an alternative parser for the message.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null,
      "references_parser": true
    },
    {
      "name": "path",
      "required": false,
      "description": "If mode is set to unix_tcp or unix_udp, set the absolute path to the Unix socket file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "If mode is set to tcp or udp, specify the port to listen for incoming messages.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": 5140,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "raw_message_key",
      "required": false,
      "description": "Specify the key where the original raw syslog message will be preserved.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "receive_buffer_size",
      "required": false,
      "description": "Specify the maximum socket receive buffer size.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+([KMGTP]i?[Bb]?|[KMGTP])?$"
      }
    },
    {
      "name": "source_address_key",
      "required": false,
      "description": "Specify the key where the source address will be injected.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/4.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "unix_perm",
      "required": false,
      "description": "If mode is set to unix_tcp or unix_udp, set the permission of the Unix socket file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
      "default": 644,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/syslog#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: Syslog."
}
