{
  "title": "Kubernetes events",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events",
  "fields": [
    {
      "name": "db",
      "required": false,
      "description": "Set a database file to keep track of recorded Kubernetes events.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "db.journal_mode",
      "required": false,
      "description": "Set the journal mode for databases.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "WAL",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "db.locking",
      "required": false,
      "description": "Specify that the database will be accessed only by Fluent Bit.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "db.sync",
      "required": false,
      "description": "Set a database sync method.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "normal",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "interval_nsec",
      "required": false,
      "description": "Set the reconnect interval (sub seconds: nanoseconds).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": 500000000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "interval_sec",
      "required": false,
      "description": "Set the reconnect interval (seconds).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "kube_ca_file",
      "required": false,
      "description": "Kubernetes TLS CA file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_ca_path",
      "required": false,
      "description": "Kubernetes TLS CA path.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_namespace",
      "required": false,
      "description": "Kubernetes namespace to query events from.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_request_limit",
      "required": false,
      "description": "Kubernetes limit parameter for events query.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "kube_retention_time",
      "required": false,
      "description": "Kubernetes retention time for events.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "1h",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_token_file",
      "required": false,
      "description": "Kubernetes authorization token file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kube_token_ttl",
      "required": false,
      "description": "Kubernetes token time to live, until it's read again from the token file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "10m",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "kube_url",
      "required": false,
      "description": "API Server endpoint.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": "https://kubernetes.default.svc",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tls.debug",
      "required": false,
      "description": "Set TLS debug level: 0 (no debug), 1 (error), 2 (state change), 3 (info), and 4 (verbose).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "tls.verify",
      "required": false,
      "description": "Enable or disable verification of TLS peer certificate.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "default": true,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tls.vhost",
      "required": false,
      "description": "Set optional TLS virtual host.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/kubernetes-events#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: Kubernetes events."
}
