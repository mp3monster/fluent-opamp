{
  "title": "Forward",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward",
  "fields": [
    {
      "name": "buffer_chunk_size",
      "required": true,
      "description": "By default the buffer to store the incoming Forward messages, don't allocate the maximum memory allowed, instead it allocate memory when it's required.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": 1024000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "buffer_max_size",
      "required": true,
      "description": "Specify the maximum buffer memory size used to receive a Forward message.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": 6144000,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "empty_shared_key",
      "required": false,
      "description": "Enable secure forward protocol with a zero-length shared key.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "listen",
      "required": false,
      "description": "Listener network interface.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": "0.0.0.0",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port to listen for incoming connections.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": 24224,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "security.users",
      "required": false,
      "description": "Specify the username and password pairs for secure forward authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "self_hostname",
      "required": false,
      "description": "Hostname for secure forward authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": "localhost",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "shared_key",
      "required": false,
      "description": "Shared key for secure forward authentication.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": false,
      "description": "Override the tag of the forwarded events with the defined value.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag_prefix",
      "required": false,
      "description": "Prefix incoming tag with the defined value.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/4.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "unix_path",
      "required": false,
      "description": "Specify the path to Unix socket to receive a Forward message.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "unix_perm",
      "required": false,
      "description": "Set the permission of the Unix socket file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/forward#configuration-parameters",
