{
  "title": "Exec Wasi",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi",
  "fields": [
    {
      "name": "wasi_path",
      "required": false,
      "description": "The place of a WASM program file.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "parser",
      "required": false,
      "description": "Specify the name of a parser to interpret the entry as a structured message.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "string",
      "validation_rule": null,
      "references_parser": true
    },
    {
      "name": "accessible_paths",
      "required": false,
      "description": "Specify the whitelist of paths to be able to access paths from WASM programs.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "interval_sec",
      "required": false,
      "description": "Polling interval (seconds).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "interval_nsec",
      "required": false,
      "description": "Polling interval (nanosecond).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "wasm_heap_size",
      "required": false,
      "description": "Size of the heap size of Wasm execution.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "wasm_stack_size",
      "required": false,
      "description": "Size of the stack size of Wasm execution.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "buf_size",
      "required": false,
      "description": "Size of the buffer (check [unit sizes](/manual/3.2/administration/configuring-fluent-bit/unit-sizes.md) for allowed values)",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "oneshot",
      "required": false,
      "description": "Only run once at startup.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/exec-wasi#configuration-parameters",
    "table_header": [
      "Key",
      "Description"
    ]
  },
  "description": "The exec\\_wasi input plugin, allows to execute WASM program that is WASI target like as external program and collects event logs from there."
}
