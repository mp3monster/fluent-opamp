{
  "title": "Kafka",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka",
  "fields": [
    {
      "name": "brokers",
      "required": false,
      "description": "Single or multiple list of Kafka Brokers, e.g: 192.168.1.3:9092, 192.168.1.4:9092.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "topics",
      "required": false,
      "description": "Single entry or list of topics separated by comma (,) that Fluent Bit will subscribe to.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "format",
      "required": false,
      "description": "Serialization format of the messages.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "client_id",
      "required": false,
      "description": "Client id passed to librdkafka.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "group_id",
      "required": false,
      "description": "Group id passed to librdkafka.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "default": "fluent-bit",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "poll_ms",
      "required": false,
      "description": "Kafka brokers polling interval in milliseconds.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "default": 500,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "buffer_max_size",
      "required": false,
      "description": "Specify the maximum size of buffer per cycle to poll kafka messages from subscribed topics.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "default": "4M",
      "data_type": "size",
      "validation_rule": {
        "kind": "size"
      }
    },
    {
      "name": "rdkafka.{property}",
      "required": false,
      "description": "{property} can be any [librdkafka properties](https://github.com/edenhill/librdkafka/blob/master/CONFIGURATION.md)",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own [thread](/manual/3.2/administration/multithreading.md#inputs).",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/inputs/kafka#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "default"
    ]
  },
  "description": "The Kafka input plugin allows subscribing to one or more Kafka topics to collect messages from an Apache Kafka service."
}
