{
  "title": "Log to Metrics",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics",
  "fields": [
    {
      "name": "tag",
      "required": false,
      "description": "Defines the tag for the generated metrics record",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "metric_mode",
      "required": false,
      "description": "Defines the mode for the metric.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "metric_name",
      "required": false,
      "description": "Sets the name of the metric.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "metric_description",
      "required": false,
      "description": "Sets a help text for the metric.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "bucket",
      "required": false,
      "description": "Defines a bucket for histogram",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "add_label",
      "required": false,
      "description": "Add a custom label NAME and set the value to the value of KEY",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "label_field",
      "required": false,
      "description": "Includes a record field as label dimension in the metric.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "value_field",
      "required": false,
      "description": "Specify the record field that holds a numerical value",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "kubernetes_mode",
      "required": false,
      "description": "If enabled, it will automatically put pod_id, pod_name, namespace_name, docker_id and container_name into the metric as labels.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "regex",
      "required": false,
      "description": "Include records in which the content of KEY matches the regular expression.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "exclude",
      "required": false,
      "description": "Exclude records in which the content of KEY matches the regular expression.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "flush_interval_sec",
      "required": false,
      "description": "The interval for metrics emission, in seconds.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "flush_interval_nsec",
      "required": false,
      "description": "The interval for metrics emission, in nanoseconds.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
      "data_type": "duration",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\\\d+(ns|us|ms|s|m|h|d)?$"
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/filters/log_to_metrics#configuration-parameters",
