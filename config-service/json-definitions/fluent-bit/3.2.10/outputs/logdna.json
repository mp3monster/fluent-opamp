{
  "title": "LogDNA",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna",
  "fields": [
    {
      "name": "logdna_host",
      "required": false,
      "description": "LogDNA API host address",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "default": "logs.logdna.com",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "logdna_port",
      "required": false,
      "description": "LogDNA TCP Port",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "default": 443,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "logdna_endpoint",
      "required": false,
      "description": "LogDNA ingestion endpoint",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "default": "/logs/ingest",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "api_key",
      "required": false,
      "description": "API key to get access to the service.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "hostname",
      "required": false,
      "description": "<p>Name of the local machine or device where Fluent Bit is running.<br></p><p>When this value is not set, Fluent Bit lookup the hostname and auto populate the value.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "mac",
      "required": false,
      "description": "Mac address.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "ip",
      "required": false,
      "description": "IP address of the local hostname.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "tags",
      "required": false,
      "description": "A list of comma separated strings to group records in LogDNA and simplify the query with filters.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "file",
      "required": false,
      "description": "Optional name of a file being monitored.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "app",
      "required": false,
      "description": "Name of the application.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "default": "Fluent Bit",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](https://docs.fluentbit.io/manual/administration/multithreading#outputs) to perform flush operations for this output.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
      "default": "\\`0\\",
      "data_type": "integer",
      "validation_rule": {
        "kind": "integer"
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/logdna#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "LogDNA is an intuitive cloud based log management system that provides you an easy interface to query your logs once they are stored."
}
