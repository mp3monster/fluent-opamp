{
  "title": "PostgreSQL",
  "doc_url": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql",
  "fields": [
    {
      "name": "host",
      "required": false,
      "description": "Hostname/IP address of the PostgreSQL instance",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": "- (127.0.0.1)",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "port",
      "required": false,
      "description": "PostgreSQL port",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": "- (5432)",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "user",
      "required": false,
      "description": "PostgreSQL username",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": "- (current user)",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "password",
      "required": false,
      "description": "Password of PostgreSQL username",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "database",
      "required": false,
      "description": "Database name to connect to",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": "- (current user)",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "table",
      "required": false,
      "description": "Table name where to store data",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "connection_options",
      "required": false,
      "description": "Specifies any valid [PostgreSQL connection options](https://www.postgresql.org/docs/devel/libpq-connect.html#LIBPQ-CONNECT-OPTIONS)",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "timestamp_key",
      "required": false,
      "description": "Key in the JSON object containing the record timestamp",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": "date",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "async",
      "required": false,
      "description": "Define if we will use async or sync connections",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "min_pool_size",
      "required": false,
      "description": "Minimum number of connection in async mode",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": 1,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "max_pool_size",
      "required": false,
      "description": "Maximum amount of connections in async mode",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": 4,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "cockroachdb",
      "required": false,
      "description": "Set to true if you will connect the plugin with a CockroachDB",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": false,
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "workers",
      "required": false,
      "description": "The number of [workers](/manual/3.2/administration/multithreading.md#outputs) to perform flush operations for this output.",
      "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
      "default": 0,
      "data_type": "integer",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "match",
      "required": false,
      "description": "Tag match pattern used to route records to this plugin. Supports '*' wildcard matching.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "match_regex",
      "required": false,
      "description": "Regular expression tag match used to route records to this plugin. Takes precedence over match when both are set.",
      "reference": "https://docs.fluentbit.io/manual/3.2/concepts/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/3.2/pipeline/outputs/postgresql#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "PostgreSQL is a very popular and versatile open source database management system that supports the SQL language and that is capable of storing both structured and unstructured data, such as JSON objects."
}
