{
  "catalog_type": "service-options",
  "schema_version": "1.0.0",
  "engine": "fluentbit",
  "fluent_bit_version": "4.2.4",
  "fluent_bit_series": "4.2",
  "section": "service",
  "cardinality": {
    "minimum": 0,
    "maximum": 1
  },
  "description": "Global Fluent Bit service section options for YAML configuration.",
  "options": [
    {
      "name": "flush",
      "required": false,
      "data_type": "integer",
      "default": "1",
      "description": "Set flush time in seconds.nanoseconds.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "grace",
      "required": false,
      "data_type": "integer",
      "default": "5",
      "description": "Set graceful shutdown wait time in seconds.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "daemon",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Run Fluent Bit as a daemon process.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "dns.mode",
      "required": false,
      "data_type": "string",
      "default": "UDP",
      "description": "Primary DNS transport protocol.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "UDP",
          "TCP"
        ]
      }
    },
    {
      "name": "log_file",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Optional absolute path for Fluent Bit log file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "log_level",
      "required": false,
      "data_type": "enum",
      "default": "info",
      "description": "Service log verbosity level.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "off",
          "error",
          "warn",
          "info",
          "debug",
          "trace"
        ]
      },
      "called_enum_options": [
        "off",
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    {
      "name": "parsers_file",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Path for standalone parsers configuration files.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "plugins_file",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Path for plugins configuration file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "streams_file",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Path for stream processor configuration file.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "http_server",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Enable built-in HTTP server.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "http_listen",
      "required": false,
      "data_type": "string",
      "default": "0.0.0.0",
      "description": "HTTP server bind interface.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "http_port",
      "required": false,
      "data_type": "integer",
      "default": "2020",
      "description": "HTTP server TCP port.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 1,
        "max": 65535
      }
    },
    {
      "name": "coro_stack_size",
      "required": false,
      "data_type": "integer",
      "default": "24576",
      "description": "Coroutine stack size in bytes.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 4096
      }
    },
    {
      "name": "scheduler.cap",
      "required": false,
      "data_type": "integer",
      "default": "2000",
      "description": "Maximum retry time in seconds.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "scheduler.base",
      "required": false,
      "data_type": "integer",
      "default": "5",
      "description": "Base for exponential backoff retries.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "json.convert_nan_to_null",
      "required": false,
      "data_type": "boolean",
      "default": "false",
      "description": "Convert NaN to null during msgpack-to-JSON conversion.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "sp.convert_from_str_to_num",
      "required": false,
      "data_type": "boolean",
      "default": "true",
      "description": "Convert numeric-looking strings to numbers in stream processor.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "hot_reload",
      "required": false,
      "data_type": "boolean",
      "default": "on",
      "description": "Enable hot reload support.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "multiline_buffer_limit",
      "required": false,
      "data_type": "string",
      "default": "2MB",
      "description": "Default multiline parser buffer limit.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\d+(B|K|KB|M|MB|G|GB)?$"
      }
    },
    {
      "name": "storage.path",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Filesystem path for chunk and stream storage.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "storage.sync",
      "required": false,
      "data_type": "string",
      "default": "normal",
      "description": "Filesystem sync mode for storage.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "normal",
          "full"
        ]
      }
    },
    {
      "name": "storage.checksum",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Enable CRC32 integrity checks for storage.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.backlog.mem_limit",
      "required": false,
      "data_type": "string",
      "default": "5M",
      "description": "Memory allocated for backlog data when filesystem storage is used.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex",
        "pattern": "^\\d+(B|K|KB|M|MB|G|GB)?$"
      }
    },
    {
      "name": "storage.max_chunks_up",
      "required": false,
      "data_type": "integer",
      "default": "128",
      "description": "Maximum in-memory chunks for filesystem storage.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 1
      }
    },
    {
      "name": "storage.metrics",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Expose storage metrics endpoint when http_server is enabled.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "dns.prefer_ipv4",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Prefer IPv4 DNS resolution results.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "dns.prefer_ipv6",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Prefer IPv6 DNS resolution results.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "dns.resolver",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "DNS resolver implementation.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "LEGACY",
          "ASYNC"
        ]
      }
    },
    {
      "name": "enable_chunk_trace",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Enable chunk tracing for debugging builds.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "hc_errors_count",
      "required": false,
      "data_type": "integer",
      "default": "5",
      "description": "Health check error threshold before unhealthy state.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "hc_period",
      "required": false,
      "data_type": "integer",
      "default": "60",
      "description": "Health check evaluation period in seconds.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 1
      }
    },
    {
      "name": "hc_retry_failure_count",
      "required": false,
      "data_type": "integer",
      "default": "5",
      "description": "Health check retry-failure threshold.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "health_check",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Expose health check endpoint on HTTP server.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "hot_reload.ensure_thread_safety",
      "required": false,
      "data_type": "boolean",
      "default": "on",
      "description": "Ensure thread-safe behavior during hot reload.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "hot_reload.timeout",
      "required": false,
      "data_type": "integer",
      "default": "0",
      "description": "Watchdog timeout in seconds for hot reload process.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 0
      }
    },
    {
      "name": "json.escape_unicode",
      "required": false,
      "data_type": "boolean",
      "default": "true",
      "description": "Escape Unicode characters during JSON serialization.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "windows.maxstdio",
      "required": false,
      "data_type": "integer",
      "default": "512",
      "description": "Windows-specific stdio limit adjustment.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "range",
        "min": 512,
        "max": 2048
      }
    },
    {
      "name": "storage.backlog.flush_on_shutdown",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Attempt to flush backlog chunks on shutdown.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.delete_irrecoverable_chunks",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Delete irrecoverable chunks at startup/runtime.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.inherit",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Allow inputs to inherit global storage.type setting.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.keep.rejected",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Store undeliverable chunks in dead-letter queue.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.rejected.path",
      "required": false,
      "data_type": "string",
      "default": "rejected",
      "description": "Subdirectory name for rejected chunks.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "regex_string"
      }
    },
    {
      "name": "storage.trim_files",
      "required": false,
      "data_type": "boolean",
      "default": "off",
      "description": "Trim chunk files after flush to reclaim disk space.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "boolean"
      }
    },
    {
      "name": "storage.type",
      "required": false,
      "data_type": "string",
      "default": "none",
      "description": "Default input storage type.",
      "reference": "https://docs.fluentbit.io/manual/4.2/administration/configuring-fluent-bit/yaml/service-section",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "memory",
          "filesystem",
          "memrb"
        ]
      }
    }
  ]
}
